{
  "name": "@torcida/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NEXT_TURBOPACK_EXPERIMENTAL_USE_SYSTEM_TLS_CERTS=1 NODE_OPTIONS=--max-old-space-size=8192 next dev",
    "dev:cache": "node scripts/dev-cache.mjs",
    "dev:clean": "node scripts/dev-cache.mjs --limpar",
    "build": "next build",
    "build:analyze": "cross-env ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "lint:mobile": "node scripts/lint-mobile.mjs --ci",
    "lint:rival-hues": "node scripts/lint-rival-hues.mjs --ci",
    "rotas:dinamicas": "node scripts/rotas-dinamicas.mjs --json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:login": "playwright codegen --save-storage=e2e/.auth/user.json http://localhost:3000/entrar",
    "municipios:atualizar": "node scripts/atualizar-municipios.mjs",
    "seed:jornadas": "vitest run --config vitest.seed.config.ts src/lib/__seed__/jornadas.seed.ts",
    "audit:jornadas": "vitest run --config vitest.audit.config.ts src/lib/__audit__/jornadas.audit.ts",
    "audit:areas-projetos": "vitest run --config vitest.audit.config.ts src/lib/__audit__/areas-projetos.audit.ts",
    "audit:dados": "vitest run --config vitest.audit.config.ts src/lib/__audit__/dados-reais.audit.ts",
    "audit:fluxos": "vitest run --config vitest.audit.config.ts src/lib/__audit__/fluxos.audit.ts",
    "audit:fluxos-avancados": "vitest run --config vitest.audit.config.ts src/lib/__audit__/fluxos-avancados.audit.ts",
    "audit:hierarquia": "vitest run --config vitest.audit.config.ts src/lib/__audit__/hierarquia.audit.ts",
    "audit:notificacoes": "vitest run --config vitest.audit.config.ts src/lib/__audit__/notificacoes.audit.ts",
    "audit:mensageria": "vitest run --config vitest.audit.config.ts src/lib/__audit__/mensageria.audit.ts",
    "audit:loja": "vitest run --config vitest.audit.config.ts src/lib/__audit__/loja.audit.ts",
    "audit:canal-restrito": "vitest run --config vitest.audit.config.ts src/lib/__audit__/canal-restrito.audit.ts",
    "audit:onboarding": "vitest run --config vitest.audit.config.ts src/lib/__audit__/onboarding-comunidade.audit.ts",
    "piloto:cockpit": "vitest run --config vitest.audit.config.ts src/lib/__audit__/piloto-cockpit.audit.ts",
    "audit:achados": "vitest run --config vitest.audit.config.ts src/lib/__audit__/achados.audit.ts",
    "audit:carteirinha-patrimonio": "vitest run --config vitest.audit.config.ts src/lib/__audit__/carteirinha-patrimonio.audit.ts",
    "audit:tudo": "node scripts/audit-tudo.mjs",
    "audit:partidas-sync": "vitest run --config vitest.audit.config.ts src/lib/__audit__/partidas-sync.audit.ts",
    "seed:partidas-sync": "vitest run --config vitest.seed.config.ts src/lib/__seed__/partidas-sync.seed.ts",
    "audit:moderacao": "vitest run --config vitest.audit.config.ts src/lib/__audit__/moderacao.audit.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@livekit/components-react": "^2.9.16",
    "@livekit/components-styles": "^1.2.0",
    "@sentry/nextjs": "^10",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.6",
    "@torcida/db": "workspace:*",
    "@torcida/types": "workspace:*",
    "@torcida/ui": "workspace:*",
    "bcryptjs": "^3.0.3",
    "ioredis": "^5.11.1",
    "livekit-client": "^2.15.7",
    "livekit-server-sdk": "^2.13.0",
    "lucide-react": "^1.22.0",
    "motion": "^12.42.2",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.29",
    "next-intl": "^3.26.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.54.2",
    "sonner": "^1.7.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.10",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
