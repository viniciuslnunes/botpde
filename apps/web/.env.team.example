# Pacote de secrets do time (DEV) — sem valores reais.
# Copie para torcida-dev.secrets.env (raiz do repo, gitignored), preencha, e
# entregue fora do git. Ver docs/ops/dev-secrets.md.
#
# O /setup faz merge sem sobrescrever chaves já preenchidas no .env.local.

# Remota — só para scripts/db-local-sync (dump). Depois o setup aponta
# DATABASE_URL para localhost.
DATABASE_URL_RAILWAY=postgresql://user:password@host.proxy.rlwy.net:PORT/railway

AUTH_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TENANT_SLUG=pde-gavioes-fiel
SUPER_ADMIN_EMAILS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=

# Opcional — Playwright / login Credentials sem OAuth
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
