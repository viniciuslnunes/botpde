# URL do PostgreSQL (mesma do bot, já no Railway)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# NextAuth — gere com: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here

# URL pública do app em produção (opcional). NÃO use localhost no Railway.
# Preferível: omitir AUTH_URL e AUTH_TRUST_HOST=true (trustHost já ativo no código).
# AUTH_URL=https://torcida.app
# AUTH_TRUST_HOST=true

# Discord OAuth — https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Google OAuth — https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Slug do tenant para desenvolvimento local
# Em produção, o tenant é resolvido pelo subdomínio
TENANT_SLUG=pde-gavioes-fiel

# Domínio raiz pra roteamento por subdomínio real (opcional).
# Em produção: seu domínio próprio (ex: torcida.app), com DNS wildcard e
# domínio customizado configurados no Railway.
# Em dev, use lvh.me — resolve *.lvh.me pra 127.0.0.1 sem precisar de DNS.
# ROOT_DOMAIN=lvh.me

# E-mails dos super admins (separados por vírgula)
SUPER_ADMIN_EMAILS=seu@email.com

# LiveKit Meet
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud
NOTICIAS_INGEST_KEY=your_ingest_key

# API-Football (sync de Partida — decisão #7). Opcional: sem a chave, a Agenda
# segue no cadastro manual. API_FOOTBALL_SEASON fixa a temporada porque o plano
# free só libera 2022–2024. Ver docs/data/integracao-api-football.md
API_FOOTBALL_KEY=
API_FOOTBALL_SEASON=2024

# URL pública da API (Next.js API Routes em desenvolvimento)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Google Maps — Street View no passo Unidade do onboarding (opcional).
# Ative Street View Static API + Geocoding API no mesmo projeto GCP.
# Sem a chave, os cards exibem fallback sem imagem de fachada.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Opcional — Map ID cloud p/ Advanced Markers (default: DEMO_MAP_ID da Google)
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# DSN do Sentry (projeto "torcida-web" na org "devinicius") — não é segredo,
# pode ficar público. Ausente = SDK desativado (no-op), sem quebrar o app.
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oXXXX.ingest.us.sentry.io/XXXX

# Ambiente
NODE_ENV=development

# Credenciais de um usuário de teste (senha via Credentials provider) usadas
# só pela suíte de captura visual (Playwright, apps/web/e2e/) para logar sem
# depender de OAuth interativo. Nunca commitar valores reais.
E2E_TEST_EMAIL=teste@example.com
E2E_TEST_PASSWORD=your_test_password
