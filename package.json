{
  "name": "torcida-saas",
  "version": "1.799.802",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push",
    "release:sync": "node scripts/release-sync.mjs",
    "version:print": "node -e \"import('./scripts/lib/version-from-git.mjs').then(m => { const v = m.computeVersionFromGit(); console.log(v.version); console.error(JSON.stringify(v, null, 2)); })\"",
    "sync:bitbucket": "node scripts/sync-bitbucket-main.mjs",
    "acli:install": "node scripts/jira/install-acli.mjs",
    "jira:auth": "node scripts/jira/auth.mjs",
    "jira:status": "node scripts/jira/status.mjs",
    "jira:view": "node scripts/jira/issue-view.mjs",
    "jira:create": "node scripts/jira/issue-create.mjs",
    "jira:edit": "node scripts/jira/issue-edit.mjs",
    "jira:transition": "node scripts/jira/issue-transition.mjs",
    "jira:seed-kan": "node scripts/jira/seed-kan-structure.mjs",
    "jira:import-commits": "node scripts/jira/import-commits.mjs",
    "apif:probe": "node scripts/api-football/probe.mjs"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.5.4",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.x",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9"
}
