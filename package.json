{
  "name": "torcida-saas",
  "version": "1.769.772",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push",
    "release:sync": "node scripts/release-sync.mjs",
    "version:print": "node -e \"import('./scripts/lib/version-from-git.mjs').then(m => { const v = m.computeVersionFromGit(); console.log(v.version); console.error(JSON.stringify(v, null, 2)); })\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.5.4",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.x",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9"
}
