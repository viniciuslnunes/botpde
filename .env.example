# Token do bot (obtenha em https://discord.com/developers/applications)
DISCORD_TOKEN=seu_token_aqui

# Application ID do bot (aba "General Information" no portal do desenvolvedor)
CLIENT_ID=seu_client_id_aqui

# ID do servidor para registrar comandos em desenvolvimento (modo guild)
GUILD_ID=id_do_seu_servidor

# URL de conexão do PostgreSQL (preenchida automaticamente pelo Railway)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Ambiente de execução
NODE_ENV=development
