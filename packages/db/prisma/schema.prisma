model Partida {

  id              String        @id @default(uuid())

  afiliacaoId     String        @map("afiliacao_id")

  adversario      String

  competicao      String?

  dataHora        DateTime      @map("data_hora")

  local           String?

  mando           MandoJogo     @default(CASA)

  placarCasa      Int?          @map("placar_casa")

  placarFora      Int?          @map("placar_fora")

  status          StatusPartida @default(AGENDADA)

  fonteExternalId String?       @map("fonte_external_id")

  criadoEm        DateTime      @default(now()) @map("criado_em")

  afiliacao Afiliacao @relation(fields: [afiliacaoId], references: [id], onDelete: Cascade)

  eventos   Evento[]

  @@index([afiliacaoId, dataHora])

  @@index([afiliacaoId, status, dataHora])

  /// Idempotência do sync externo (decisão #7): o mesmo fixture nunca vira duas
  /// Partidas do mesmo clube. NÃO protege contra duas Afiliacao apontando para o
  /// mesmo time — isso é duplicata de catálogo, barrada no seed de ids.
  @@unique([afiliacaoId, fonteExternalId])

  @@map("saas_partidas")

}

