  beneficios    String?

  ativo         Boolean                    @default(true)

  criadoEm      DateTime                   @default(now()) @map("criado_em")

  atualizadoEm  DateTime                   @updatedAt @map("atualizado_em")



  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  membros   SaasMembro[]

  cobrancas CobrancaAssociacao[]



  @@index([tenantId, ativo])

  @@map("saas_planos_associacao")

}



enum PeriodicidadePlanoAssociacao {

  MENSAL

  TRIMESTRAL

  ANUAL

  UNICA

}



model CobrancaAssociacao {

  id       String @id @default(uuid())

  tenantId String @map("tenant_id")

  userId   String @map("user_id")

  membroId String? @map("membro_id")



  planoAssociacaoId String? @map("plano_associacao_id")

  /// Vaga de caravana / cobrança vinculada a evento (paridade C1).

  eventoId          String? @map("evento_id")

  tipo              TipoCobrancaAssociacao

  descricao         String

  valor             Decimal @db.Decimal(12, 2)

  vencimento        DateTime

  status            StatusCobrancaAssociacao @default(PENDENTE)

  pagoEm            DateTime? @map("pago_em")

  metodoPagamento   MetodoPagamentoCobranca? @map("metodo_pagamento")



  pixCopiaCola      String? @map("pix_copia_cola")

  gatewayProvider   String? @map("gateway_provider")

  gatewayExternalId String? @map("gateway_external_id")



  financeiroLancamentoId String? @unique @map("financeiro_lancamento_id")



  criadoPorId  String?  @map("criado_por_id")

  criadoEm     DateTime @default(now()) @map("criado_em")

  atualizadoEm DateTime @updatedAt @map("atualizado_em")



  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  membro          SaasMembro?      @relation(fields: [membroId], references: [id], onDelete: SetNull)

  planoAssociacao PlanoAssociacao? @relation(fields: [planoAssociacaoId], references: [id], onDelete: SetNull)

  evento          Evento?          @relation(fields: [eventoId], references: [id], onDelete: SetNull)

  criadoPor       User?            @relation("CobrancaAssociacaoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)



  @@index([tenantId, status, vencimento])

  @@index([tenantId, userId])

  @@index([membroId])

  @@index([eventoId])

  @@index([gatewayExternalId])

  @@unique([eventoId, userId])

  @@map("saas_cobrancas_associacao")

}



enum TipoCobrancaAssociacao {

  MENSALIDADE

  ADESAO

  AVULSA

}



enum StatusCobrancaAssociacao {

  PENDENTE

  PAGA

  CANCELADA

  VENCIDA

}



enum MetodoPagamentoCobranca {

  MANUAL

  PIX

}



// ─── BLOQUEADOS ───────────────────────────────────────────────────────────────



model Bloqueado {

  id       String @id @default(uuid())

  tenantId String @map("tenant_id")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)



  registro         String

  nome             String?

  motivo           String?

  bloqueadoPorId   String?  @map("bloqueado_por_id")

  bloqueadoPorNome String?  @map("bloqueado_por_nome")

  criadoEm         DateTime @default(now()) @map("criado_em")



  @@unique([tenantId, registro])

  @@map("saas_bloqueados")

}



// ─── SEDES ────────────────────────────────────────────────────────────────────



model Sede {

  id String @id @default(uuid())



  // tenantId é OPCIONAL — uma subsede ou ponto de encontro pode existir

  // de forma independente antes da sede principal aderir à plataforma.

  // Quando a sede principal aderir, basta atribuir o tenantId.

  tenantId String? @map("tenant_id")

  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)



  nome        String

  tipo        TipoSede @default(PONTO_ENCONTRO)

  endereco    String?

  cidade      String?

  estado      String?

  cep         String?

  lat         Float?

  lng         Float?

  capacidade  Int?

  responsavel String?

  /// Usuário responsável pela unidade (liderança local). Identidade; poder vem via Caso B (owner).

  responsavelUserId String? @map("responsavel_user_id")

  responsavelUser   User?   @relation("SedeResponsavel", fields: [responsavelUserId], references: [id], onDelete: SetNull)

  telefone    String?

  horarios    String?

  descricao   String?

  fotoUrl     String?  @map("foto_url")

  ativa       Boolean  @default(true)

  criadoEm    DateTime @default(now()) @map("criado_em")



  // Hierarquia: subsede aponta para sede pai (também pode ser null)

  sedeId String? @map("sede_id")

  sede   Sede?   @relation("SedeFilhos", fields: [sedeId], references: [id])

  filhos Sede[]  @relation("SedeFilhos")



  // Referência à sede pai que AINDA NÃO É TENANT (pré-adesão)

  // Ex: PDE aponta para "Gaviões da Fiel" que ainda não aderiu

  sedeReferenciaNome String? @map("sede_referencia_nome")

  sedeReferenciaSlug String? @map("sede_referencia_slug")



  /// Canal (Conversa tipo CANAL) oficial da unidade — existe em Caso A e Caso B.

  canalConversaId String? @unique @map("canal_conversa_id")

  canalConversa   Conversa? @relation("SedeCanal", fields: [canalConversaId], references: [id], onDelete: SetNull)



  /// Solicitação de unidade que originou esta Sede (quando veio de afiliação).

  solicitacaoUnidade SolicitacaoUnidade? @relation("SolicitacaoUnidadeSede")



  eventos Evento[]

  membros SaasMembro[]

  barCategorias           BarCategoria[]

  barProdutos             BarProduto[]

  barVendas               BarVenda[]

  barMovimentacoesEstoque BarMovimentacaoEstoque[]

  barCaixaTurnos          BarCaixaTurno[]


  @@index([tenantId])

  @@index([sedeId])

  @@index([responsavelUserId])

  @@map("saas_sedes")

}



enum TipoSede {

  SEDE

  SUBSEDE

  PONTO_ENCONTRO

}



// ─── SOLICITAÇÃO DE UNIDADE (afiliação de subsede/PDE à torcida) ─────────────
// Nasce no onboarding ("Solicitar cadastro de unidade") para uma unidade que a
// base ainda não conhece. Super-admin ou Presidente/Vice da torcida-alvo
// revisam e, ao APROVAR, cria-se a Sede (SUBSEDE/PDE) sob a torcida = vínculo
// formal. NÃO confundir com Alianca (torcidas-pares do mesmo clube).



model SolicitacaoUnidade {

  id String @id @default(uuid())



  /// Torcida principal (Sede) alvo do vínculo.

  tenantId String @map("tenant_id")

  tenant   Tenant @relation("TenantSolicitacoesUnidade", fields: [tenantId], references: [id], onDelete: Cascade)



  nome   String

  /// SUBSEDE | PONTO_ENCONTRO (nunca SEDE — validado na aplicação).

  tipo   TipoSede @default(PONTO_ENCONTRO)

  cidade String

  estado String

  endereco String?

  regiao   String?



  contatoNome     String  @map("contato_nome")

  contatoEmail    String? @map("contato_email")

  contatoTelefone String? @map("contato_telefone")



  /// Como comprova o credenciamento (vínculo com a diretoria etc.).

  vinculo    String?

  observacao String?

  provasUrls String[] @default([]) @map("provas_urls")



  status StatusSolicitacaoUnidade @default(PENDENTE)



  solicitadoPorId String? @map("solicitado_por_id")

  solicitadoPor   User?   @relation("SolicitacaoUnidadeSolicitante", fields: [solicitadoPorId], references: [id], onDelete: SetNull)



  decididoPorId String?   @map("decidido_por_id")

  decididoPor   User?     @relation("SolicitacaoUnidadeDecisor", fields: [decididoPorId], references: [id], onDelete: SetNull)

  decididoEm    DateTime? @map("decidido_em")

  /// Justificativa da recusa.

  motivo String?



  /// Sede criada ao aprovar (vínculo formal materializado).

  sedeId String? @unique @map("sede_id")

  sede   Sede?   @relation("SolicitacaoUnidadeSede", fields: [sedeId], references: [id], onDelete: SetNull)



  criadoEm     DateTime @default(now()) @map("criado_em")

  atualizadoEm DateTime @updatedAt @map("atualizado_em")



  @@index([tenantId, status])

  @@index([status])

  @@map("saas_solicitacoes_unidade")

}



enum StatusSolicitacaoUnidade {

  PENDENTE

  APROVADA

  RECUSADA

}



// ─── EVENTOS ──────────────────────────────────────────────────────────────────



model Evento {

  id       String @id @default(uuid())

  tenantId String @map("tenant_id")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)



  /// Classifica o uso no portal (caravana, ensaio) sem duplicar o módulo.

  tipo      TipoEvento @default(GERAL)

  titulo    String

  descricao String?

  /// Capa do evento na agenda (URL pública).

  fotoUrl   String?  @map("foto_url")

  data      DateTime

  local     String?

  sedeId    String?  @map("sede_id")

  sede      Sede?    @relation(fields: [sedeId], references: [id])

  lat       Float?

  lng       Float?

  /// Valor da vaga (caravana paga). Null = caravana sem cobrança.

  valorVaga Decimal? @map("valor_vaga") @db.Decimal(12, 2)

  /// Override de lotação. Null = usa `Sede.capacidade` quando houver sede.

  capacidade Int?

  serieId String? @map("serie_id")

  partidaId String? @map("partida_id")

  partida   Partida? @relation(fields: [partidaId], references: [id], onDelete: SetNull)



  criadoPorId      String?  @map("criado_por_id")

  criadoEm         DateTime @default(now()) @map("criado_em")

  discordMessageId String?  @map("discord_message_id")



  rsvps     EventoRsvp[]

  salas     SalaReuniao[]

  posts     Post[]

  cobrancas CobrancaAssociacao[]



  @@index([tenantId])

  @@index([sedeId])

  @@index([serieId])

  @@index([partidaId])

  @@index([tenantId, data])

  @@index([tenantId, tipo, data])

  @@map("saas_eventos")

}



model EventoRsvp {

  id       String     @id @default(uuid())

  eventoId String     @map("evento_id")

  userId   String     @map("user_id")

  status   RsvpStatus @default(CONFIRMADO)

  criadoEm DateTime   @default(now()) @map("criado_em")



  // Check-in real — independente do status de RSVP. Confirmar presença

  // (status) não equivale a comparecer de fato (checkedInAt): alguém pode

  // confirmar e faltar, ou aparecer e ser check-in sem ter confirmado antes.

  checkedInAt    DateTime? @map("checked_in_at")

  checkedInPorId String?   @map("checked_in_por_id")



  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  user   User   @relation(fields: [userId], references: [id])



  @@unique([eventoId, userId])

  @@index([eventoId, status, criadoEm])

  @@map("saas_evento_rsvps")

}



enum RsvpStatus {

  CONFIRMADO

  RECUSADO

  LISTA_ESPERA

}



enum TipoEvento {

  GERAL

  CARAVANA

  ENSAIO

}



// ─── LOJA SaaS ────────────────────────────────────────────────────────────────



model SaasCategoria {

