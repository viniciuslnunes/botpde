  curadoPor User?     @relation(fields: [curadoPorId], references: [id])



  @@unique([afiliacaoId, url])

  @@index([afiliacaoId, status, publicadoEm])

  @@map("saas_noticias")

}



enum StatusNoticia {

  RASCUNHO

  APROVADA

  REJEITADA

}



// ─── SALAS MEET (WebRTC) ─────────────────────────────────────────────────────



