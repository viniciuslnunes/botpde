// ─── MENSAGERIA (DM 1×1 e grupos — ver ARCHITECTURE.md §6 item 27) ──────────



model Conversa {

  id   String       @id @default(uuid())

  tipo TipoConversa



  // Tenant onde a conversa foi iniciada — contexto/auditoria. A LEITURA é

  // chaveada por participação (MembroConversa), não por tenant: é o que

  // permite DM entre membros de torcidas aliadas.

  tenantId String @map("tenant_id")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)



  // Só para GRUPO — DM não tem nome/descrição/avatar próprios

  nome      String?

  descricao String?

  avatarUrl String? @map("avatar_url")

  // Grupos públicos da comunidade — qualquer membro ativo do tenant pode entrar

  publica   Boolean @default(false)

  /// true = grupo da Comunidade (lista/mural); false = só mensageria

  comunidade Boolean @default(false)

  /// Código curto para link de convite

  codigoConvite String? @unique @map("codigo_convite")



  // CANAL — comunidade temática ou perfil oficial da unidade (M3 mensageria)

  institucional       Boolean           @default(false) @map("institucional")

  canalOficial        Boolean           @default(false) @map("canal_oficial")

  visibilidadeCanal   VisibilidadeCanal @default(HIERARQUIA) @map("visibilidade_canal")

  /// Mural do canal: quando true, só admins publicam posts

  somenteAdminPublica Boolean           @default(true) @map("somente_admin_publica")



  criadoPorId String @map("criado_por_id")

  criadoPor   User   @relation("ConversaCriadaPor", fields: [criadoPorId], references: [id], onDelete: Cascade)



  criadoEm     DateTime @default(now()) @map("criado_em")

  // Bumpado a cada mensagem — ordena a inbox por atividade recente

  atualizadoEm DateTime @updatedAt @map("atualizado_em")



  membros   MembroConversa[]

  mensagens MensagemDireta[]

  posts     Post[]

  departamentoCanal Departamento? @relation("DepartamentoCanal")

  sedeCanal Sede? @relation("SedeCanal")



  @@index([tenantId, atualizadoEm])

  @@index([tenantId, tipo, canalOficial])

  @@index([tenantId, tipo, publica])

  @@map("saas_conversas")

}



enum TipoConversa {

  DIRETA

  GRUPO

  CANAL

}



enum VisibilidadeCanal {

  TENANT

  HIERARQUIA

  ALIADOS

  PUBLICO

}



model MembroConversa {

