  mando           MandoJogo     @default(CASA)

  placarCasa      Int?          @map("placar_casa")

  placarFora      Int?          @map("placar_fora")

  status          StatusPartida @default(AGENDADA)

  fonteExternalId String?       @map("fonte_external_id")

  criadoEm        DateTime      @default(now()) @map("criado_em")

  afiliacao Afiliacao @relation(fields: [afiliacaoId], references: [id], onDelete: Cascade)

  eventos   Evento[]

  @@index([afiliacaoId, dataHora])

  @@index([afiliacaoId, status, dataHora])

  @@map("saas_partidas")

}

enum MandoJogo {

  CASA

  FORA

}



enum StatusPartida {

  AGENDADA

  AO_VIVO

  ENCERRADA

  CANCELADA

}



model Noticia {

  id              String        @id @default(uuid())

  afiliacaoId     String        @map("afiliacao_id")

  titulo          String

  resumo          String?

  url             String

  fonte           String

  embedHtml       String?       @map("embed_html")

  embedThumbnail  String?       @map("embed_thumbnail")

  status          StatusNoticia @default(RASCUNHO)

  publicadoEm     DateTime?     @map("publicado_em")

  curadoPorId     String?       @map("curado_por_id")

  criadoEm        DateTime      @default(now()) @map("criado_em")



