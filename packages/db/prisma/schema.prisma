generator client {

  provider = "prisma-client-js"

}



datasource db {

  provider = "postgresql"

  url      = env("DATABASE_URL")

}



// ═══════════════════════════════════════════════════════════════

// TABELAS EXISTENTES DO BOT (leitura/escrita pelo bot via pg)

// O Prisma pode ler estas tabelas, mas NÃO altera sua estrutura.

// ═══════════════════════════════════════════════════════════════



/// Tabela legada do bot — lida pelo SaaS para exibir dados no portal

model BotMembro {

  id              Int       @id @default(autoincrement())

  discordId       String    @unique @map("discord_id")

  nome            String

  tipo            String // 'socio' ou 'torcedor'

  numeroAssociado String?   @map("numero_associado")

  cidade          String?

  telefone        String?

  idade           Int?

  aprovadoPorId   String?   @map("aprovado_por_id")

  aprovadoPorNome String?   @map("aprovado_por_nome")

  criadoEm        DateTime? @default(now()) @map("criado_em")

  imagemProva     String?   @map("imagem_prova")



  @@map("membros")

}



/// Tabela legada do bot — produtos da loja

model BotProduto {

  id        Int         @id @default(autoincrement())

  nome      String

  tamanhos  String

  preco     Decimal     @db.Decimal(10, 2)

  imagemUrl String?     @map("imagem_url")

  ativo     Boolean?    @default(true)

  criadoEm  DateTime?   @default(now()) @map("criado_em")

  estoque   Json?       @default("{}")

  pedidos   BotPedido[]



  @@map("produtos")

}



/// Tabela legada do bot — pedidos da loja

model BotPedido {

  id            Int         @id @default(autoincrement())

  discordId     String      @map("discord_id")

  discordTag    String?     @map("discord_tag")

  produtoId     Int?        @map("produto_id")

  produtoNome   String?     @map("produto_nome")

  tamanho       String?

  quantidade    Int

  precoUnit     Decimal?    @map("preco_unit") @db.Decimal(10, 2)

  total         Decimal?    @db.Decimal(10, 2)

  status        String?     @default("pendente")

  canalTicketId String?     @map("canal_ticket_id")

  criadoEm      DateTime?   @default(now()) @map("criado_em")

  produto       BotProduto? @relation(fields: [produtoId], references: [id], onDelete: NoAction, onUpdate: NoAction)



  @@map("pedidos")

}



/// Tabela legada do bot — ranking de recrutadores

model BotAprovacao {

  id            Int       @id @default(autoincrement())

  aprovadorId   String    @map("aprovador_id")

  aprovadorNome String?   @map("aprovador_nome")

  candidatoId   String?   @map("candidato_id")

  candidatoNome String?   @map("candidato_nome")

  tipo          String?

  criadoEm      DateTime? @default(now()) @map("criado_em")



  @@map("aprovacoes_recrutamento")

}



/// Tabela legada do bot — configurações persistidas (IDs de mensagens)

model BotConfig {

  key   String  @id

  value String?



  @@map("bot_config")

}



// ═══════════════════════════════════════════════════════════════

// TABELAS DO SAAS — novas, prefixo saas_ para evitar conflitos

// ═══════════════════════════════════════════════════════════════



// ─── TENANTS ────────────────────────────────────────────────────────────────



model Tenant {

  id          String   @id @default(uuid())

  slug        String   @unique

  nome        String

  plano       Plano    @default(FREE)

  corPrimaria String   @default("#7c3aed") @map("cor_primaria")

  logoUrl     String?  @map("logo_url")

  /// Tema visual completo (marca, grade, superfícies claro/escuro). Ver TenantDesignSchema.

  design      Json?    @map("design")

  ativo       Boolean  @default(true)

  criadoEm    DateTime @default(now()) @map("criado_em")



  /// R3 — hierarquia opt-in: quando true, subsedes/PDEs descendentes enxergam a

  /// worktree completa da torcida. Só a raiz SEDE consome este toggle.

  hierarquiaVisivelParaFilhos Boolean @default(false) @map("hierarquia_visivel_para_filhos")



  // Tenant sintético: container de posts de torcedores globais do clube

  // (Comunidade Nacional). Sem Sede/Role/SaasMembro; nunca listado como torcida real.

  sintetico Boolean @default(false) @map("sintetico")



  // Banco de dados próprio do tenant (null = usa o banco compartilhado)

  // Cada torcida pode ter seu banco isolado quando necessário

  databaseUrl String? @map("database_url")



  discordGuildId String? @unique @map("discord_guild_id")



  afiliacaoId String?     @map("afiliacao_id")

  afiliacao   Afiliacao?  @relation(fields: [afiliacaoId], references: [id], onDelete: SetNull)



  // Vínculo opcional ao catálogo nacional (dados ricos: fundação, lema, sede, site).

  // Tenants pré-criados a partir de TorcidaConhecida referenciam a origem aqui.

  torcidaConhecidaId String?           @unique @map("torcida_conhecida_id")

  torcidaConhecida   TorcidaConhecida? @relation(fields: [torcidaConhecidaId], references: [id], onDelete: SetNull)



  membros           SaasMembro[]

  socios            SaasSocio[]

  produtos          SaasProduto[]

  categoriasLoja    SaasCategoria[]

  cuponsLoja        SaasCupom[]

  carrinhoItens     SaasCarrinhoItem[]

  pedidos           SaasPedido[]

  sedes             Sede[]

  eventos           Evento[]

  roles             Role[]

  userRoles         UserRole[]

  userPermissions   UserPermission[]

  departamentos     Departamento[]

  userDepartamentos UserDepartamento[]

  auditLogs         AuditLog[]

  bloqueados        Bloqueado[]

  posts             Post[]

  advertencias      Advertencia[]

  announcements     Announcement[]

  importacoes       ImportacaoMembros[]

  aliancasOrigem    Alianca[]             @relation("AliancaOrigem")

  aliancasAliado    Alianca[]             @relation("AliancaAliado")

  recomendacoes     RecomendacaoAlianca[]

  perfisMembro      PerfilMembro[]

  seguimentosCtx    Seguimento[]          @relation("SeguimentoContexto")

  salasReuniao      SalaReuniao[]

  denuncias         Denuncia[]

  conversas         Conversa[]

  denunciasMensagem DenunciaMensagem[]    @relation("DenunciaMensagemTenant")

  hashtags          Hashtag[]

  perfilDestaques   PerfilDestaque[]

  postSalvos        PostSalvo[]

  momentosStory     MomentoStory[]

  rivalTorcidaA     RivalidadeTorcida[]   @relation("RivalTorcidaA")

  rivalTorcidaB     RivalidadeTorcida[]   @relation("RivalTorcidaB")

  financeiroLancamentos FinanceiroLancamento[]

  patrimonioItens       PatrimonioItem[]

  planosAssociacao      PlanoAssociacao[]

  cobrancasAssociacao   CobrancaAssociacao[]

  barCategorias           BarCategoria[]

  barProdutos             BarProduto[]

  barVendas               BarVenda[]

  barMovimentacoesEstoque BarMovimentacaoEstoque[]

  barCaixaTurnos          BarCaixaTurno[]

  solicitacoesUnidade     SolicitacaoUnidade[]     @relation("TenantSolicitacoesUnidade")


  /// Config: exibir o balanço financeiro consolidado aos associados no portal.

  balancoFinanceiroVisivel Boolean @default(false) @map("balanco_financeiro_visivel")

  /// Quanto detalhe o balanço público mostra (totais / categorias / lançamentos).
  balancoDetalheNivel BalancoDetalheNivel @default(COMPLETO) @map("balanco_detalhe_nivel")


  @@map("saas_tenants")

}



enum BalancoDetalheNivel {
  TOTAIS
  CATEGORIAS
  COMPLETO
}

enum Plano {

  FREE

  BASIC

  PREMIUM

}



// ─── USUÁRIOS ────────────────────────────────────────────────────────────────



model User {

  id           String    @id @default(uuid())

  email        String?   @unique

  nome         String?

  /// Handle único global (@usuario) — referência pública no feed/perfil.

  nickname     String?   @unique

  avatarUrl    String?   @map("avatar_url")

  criadoEm     DateTime  @default(now()) @map("criado_em")

  discordId    String?   @unique @map("discord_id")

  googleId     String?   @unique @map("google_id")

  // Hash bcrypt — só usuários que se cadastraram por e-mail/senha têm valor.

  // Nunca preenchido para contas só-OAuth (Discord/Google).

  senhaHash    String?   @map("senha_hash")

  consentidoEm DateTime? @map("consentido_em")

  /// Última atividade na plataforma (heartbeat throttled) — base de "online" no onboarding.

  ultimoAcessoEm DateTime? @map("ultimo_acesso_em")



  userRoles            UserRole[]

  userPermissions      UserPermission[]

  userDepartamentos    UserDepartamento[]

  departamentosGeridos DepartamentoGestor[]

  membros              SaasMembro[]

  socios               SaasSocio[]

  pedidos              SaasPedido[]

  carrinhoItens        SaasCarrinhoItem[]

  eventosRsvp          EventoRsvp[]

  sedesResponsavel     Sede[]               @relation("SedeResponsavel")

  posts                Post[]

  auditLogs            AuditLog[]           @relation("AuditAtor")

  announcements        Announcement[]

  announcementReads    AnnouncementRead[]

  perfisMembro         PerfilMembro[]

  seguindo             Seguimento[]         @relation("SeguimentoSeguidor")

  seguidores           Seguimento[]         @relation("SeguimentoSeguido")

  comentarios          Comentario[]

  reacoes              Reacao[]

  denuncias            Denuncia[]

  denunciasResolvidas  Denuncia[]           @relation("DenunciaResolvidoPor")

  notificacoes         Notificacao[]

  notificacoesAtor     Notificacao[]        @relation("NotificacaoAtor")

  noticiasCuradas      Noticia[]

  aliancasPropostas    Alianca[]            @relation("AliancaPropostaPor")

  aliancasConfirmadas  Alianca[]            @relation("AliancaConfirmadaPor")

  salasHospedadas      SalaReuniao[]

  participacoesReuniao ParticipanteReuniao[]

  mensagensReuniao     MensagemReuniao[]

  enquetesReuniao      EnqueteReuniao[]

  votosEnqueteReuniao  VotoEnqueteReuniao[]



  conversasCriadas            Conversa[]         @relation("ConversaCriadaPor")

  membroConversas             MembroConversa[]

  mensagensDiretas            MensagemDireta[]   @relation("MensagemDiretaAutor")

  bloqueiosFeitos             BloqueioUsuario[]  @relation("BloqueioBloqueador")

  bloqueiosRecebidos          BloqueioUsuario[]  @relation("BloqueioBloqueado")

  denunciasMensagem           DenunciaMensagem[] @relation("DenunciaMensagemDenunciante")

  denunciasMensagemResolvidas DenunciaMensagem[] @relation("DenunciaMensagemResolvidoPor")

  votosEnquetePost            VotoEnquetePost[]

  perfilDestaques             PerfilDestaque[]

  postsSalvos                 PostSalvo[]

  feedTimeline                FeedTimeline[]

  momentosStory               MomentoStory[]

  perfilTorcedor              PerfilTorcedor?

  financeiroLancamentosCriados FinanceiroLancamento[] @relation("FinanceiroLancamentoCriadoPor")

  patrimonioItensCriados       PatrimonioItem[]       @relation("PatrimonioItemCriadoPor")

  patrimonioItensResponsavel   PatrimonioItem[]       @relation("PatrimonioItemResponsavel")

  cobrancasAssociacao          CobrancaAssociacao[]

  cobrancasAssociacaoCriadas   CobrancaAssociacao[]   @relation("CobrancaAssociacaoCriadoPor")

  barProdutosCriados           BarProduto[]           @relation("BarProdutoCriadoPor")

  barVendasOperadas            BarVenda[]             @relation("BarVendaOperador")

  barMovimentacoesEstoque      BarMovimentacaoEstoque[] @relation("BarMovimentacaoOperador")

  barCaixaTurnosAbertos        BarCaixaTurno[]        @relation("BarCaixaTurnoAbertoPor")
  barCaixaTurnosFechados       BarCaixaTurno[]        @relation("BarCaixaTurnoFechadoPor")

  solicitacoesUnidadeFeitas    SolicitacaoUnidade[]  @relation("SolicitacaoUnidadeSolicitante")

  solicitacoesUnidadeDecididas SolicitacaoUnidade[]  @relation("SolicitacaoUnidadeDecisor")


  @@map("saas_users")

}



// ─── CARGOS E PERMISSÕES ─────────────────────────────────────────────────────



model Role {

  id          String   @id @default(uuid())

  tenantId    String   @map("tenant_id")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nome        String

  cor         String   @default("#6b7280")

  ordem       Int      @default(0)

  isSystem    Boolean  @default(false) @map("is_system")

  /// Pacote legado / transversal (sem departamento). Perfis de área preferem

  /// herança ao vivo do Departamento + permissionsExtras.

  permissions String[] @default([])

  /// Deltas além do pacote do departamento (Presidente, perfis compostos…).

  permissionsExtras String[] @default([]) @map("permissions_extras")

  /// Área de atuação — null = perfil transversal (ex.: member).

  departamentoId String? @map("departamento_id")

  departamento   Departamento? @relation(fields: [departamentoId], references: [id], onDelete: SetNull)

  /// MEMBRO | GESTOR — obrigatório quando departamentoId está setado.

  papelNoDepartamento String? @map("papel_no_departamento")



  userRoles UserRole[]



  @@unique([tenantId, nome])

  @@index([departamentoId])

  @@map("saas_roles")

}



model UserRole {

  id       String @id @default(uuid())

  userId   String @map("user_id")

  tenantId String @map("tenant_id")

  roleId   String @map("role_id")



  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)



  criadoEm DateTime @default(now()) @map("criado_em")



  @@unique([userId, tenantId, roleId])

  @@index([tenantId])

  @@map("saas_user_roles")

}



model UserPermission {

  id         String  @id @default(uuid())

  userId     String  @map("user_id")

  tenantId   String  @map("tenant_id")

  permission String

  granted    Boolean



  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)



  criadoEm DateTime @default(now()) @map("criado_em")



  @@unique([userId, tenantId, permission])

  @@index([tenantId])

  @@map("saas_user_permissions")

}



// ─── DEPARTAMENTOS ────────────────────────────────────────────────────────────

// Agrupamento organizacional (Diretoria, Financeiro, Comunicação…).

// Perfis (Role) de área vinculam-se ao departamento (membro/gestor) e herdam

// o pacote ao vivo; Role.permissionsExtras guarda deltas. UserDepartamento /

// DepartamentoGestor são projeção ao atribuir o perfil.

// Sócio/Torcedor NÃO são departamentos. Lista plana por tenant (MVP).



model Departamento {

  id       String @id @default(uuid())

  tenantId String @map("tenant_id")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)



  nome         String

  slug         String   @default("")

  moduloPortal String?  @map("modulo_portal")

  /// Permissões do membro da equipe (ver / agir leve).

  permissions  String[] @default([])

  /// Permissões adicionais do gestor (gerir a área). Composição:

  /// membro → permissions; gestor → permissions ∪ permissionsGestor.

  permissionsGestor String[] @default([]) @map("permissions_gestor")

  cor          String   @default("#6b7280")

  ordem        Int      @default(0)

  /// Canal (Conversa tipo CANAL) oficial da área — deep-link no portal.

  canalConversaId String? @unique @map("canal_conversa_id")

  canalConversa   Conversa? @relation("DepartamentoCanal", fields: [canalConversaId], references: [id], onDelete: SetNull)

  /// Meta de área (ex.: checklist barracão do Carnaval). Não é RBAC.

  meta         Json?

  criadoEm     DateTime @default(now()) @map("criado_em")



  membros  UserDepartamento[]

  gestores DepartamentoGestor[]

  roles    Role[]

  /// Preferência de área no cadastro (SaasMembro) — sem membership até APROVADO.

  solicitacoesMembros SaasMembro[]



  @@unique([tenantId, nome])

  @@unique([tenantId, slug])

  @@map("saas_departamentos")

}



/// Associação usuário ↔ departamento (multi-departamento, como cargos do Discord)

model UserDepartamento {

  id             String @id @default(uuid())

  userId         String @map("user_id")

  tenantId       String @map("tenant_id")

  departamentoId String @map("departamento_id")



  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  departamento Departamento @relation(fields: [departamentoId], references: [id], onDelete: Cascade)



  criadoEm DateTime @default(now()) @map("criado_em")



  @@unique([userId, tenantId, departamentoId])

  @@index([departamentoId])

  @@map("saas_user_departamentos")

}



/// Quem pode gerenciar os membros de um departamento (adicionar/remover membros,

/// atribuir perfis dentro do escopo do departamento). Owners/admins do tenant

/// (via Role.isSystem) continuam com acesso total independente desta tabela —

/// isso serve para delegar gestão de UM departamento específico a alguém que

/// não é admin geral (ex: liderança de um departamento na subsede/pde).

model DepartamentoGestor {

  id             String @id @default(uuid())

  departamentoId String @map("departamento_id")

  userId         String @map("user_id")



  departamento Departamento @relation(fields: [departamentoId], references: [id], onDelete: Cascade)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)



  criadoEm DateTime @default(now()) @map("criado_em")



  @@unique([departamentoId, userId])

  @@index([userId])

  @@map("saas_departamento_gestores")

}



// ─── MEMBROS SaaS ─────────────────────────────────────────────────────────────



model SaasMembro {

  id       String @id @default(uuid())

  tenantId String @map("tenant_id")

  userId   String @map("user_id")



  tipo            TipoMembro

  nome            String

  idade           Int?

  telefone        String?

  cidade          String?

  numeroAssociado String?      @map("numero_associado")

  anosSocio       Int?         @map("anos_socio")

  cep             String?      @map("cep")

  numero          String?      @map("numero")

  bloco           String?      @map("bloco")

  complemento     String?      @map("complemento")

  imagemProva     String?      @map("imagem_prova")

  status          StatusMembro @default(PENDENTE)



  // Campos LGE (Lei 14.597/2023) — sensíveis; nunca em perfil público.

  rg             String?

  /// Somente dígitos; único por tenant quando preenchido.

  cpf            String?

  filiacao       String?

  escolaridade   String?

  profissao      String?

  dataNascimento DateTime? @map("data_nascimento")



  /// Plano de associação da torcida (não confundir com Tenant.plano SaaS).

  planoAssociacaoId String?           @map("plano_associacao_id")

  planoAssociacao   PlanoAssociacao?  @relation(fields: [planoAssociacaoId], references: [id], onDelete: SetNull)

  /// Espelho operacional: false se há cobrança vencida/pendente relevante.

  adimplente Boolean @default(true)



  aprovadoPorId   String?   @map("aprovado_por_id")

  aprovadoPorNome String?   @map("aprovado_por_nome")

  aprovadoEm      DateTime? @map("aprovado_em")



  // Desligamento estatutário (MEMBERS_DISMISS) — distinto de bloqueio.

  desligadoEm     DateTime? @map("desligado_em")

  desligadoMotivo String?   @map("desligado_motivo")

  desligadoPorId  String?   @map("desligado_por_id")



  // Referência ao registro legado do bot (para migração gradual)

  discordId  String? @map("discord_id")

  discordTag String? @map("discord_tag")



  // Vínculo territorial principal — a qual Sede/Subsede/PDE específica do

  // tenant este associado pertence (um tenant pode ter várias linhas de

  // Sede, ex: vários pontos de encontro). Nullable para não quebrar

  // cadastros existentes e tenants com uma única Sede.

  sedeId String? @map("sede_id")

  sede   Sede?   @relation(fields: [sedeId], references: [id], onDelete: SetNull)



  /// Departamento pretendido no onboarding (sócio). NÃO cria UserDepartamento

  /// nem perfil de área enquanto status ≠ APROVADO — só após aprovarMembro.

  departamentoId String?       @map("departamento_id")

  departamento   Departamento? @relation(fields: [departamentoId], references: [id], onDelete: SetNull)



  // Rastro de origem: qual importação criou este membro (null = cadastro

  // orgânico). Permite auditar e desfazer importações (ex: dados MOCK de

  // demonstração) sem tocar em membros reais.

  importacaoId String?            @map("importacao_id")

  importacao   ImportacaoMembros? @relation(fields: [importacaoId], references: [id], onDelete: SetNull)



  criadoEm     DateTime @default(now()) @map("criado_em")

  atualizadoEm DateTime @updatedAt @map("atualizado_em")



  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  user      User                 @relation(fields: [userId], references: [id])

  cobrancas CobrancaAssociacao[]



  @@unique([tenantId, userId])

  @@unique([tenantId, cpf])

  @@index([sedeId])

  @@index([departamentoId])

  @@index([importacaoId])

  @@index([tenantId, status])

  @@index([tenantId, adimplente])

  @@index([planoAssociacaoId])

  @@map("saas_membros")

}



enum TipoMembro {

  SOCIO

  TORCEDOR

}



enum StatusMembro {

  PENDENTE

  APROVADO

  REPROVADO

}



// ─── IMPORTAÇÃO DE MEMBROS ───────────────────────────────────────────────────

// Staging + auditoria de cada execução de importação da base de associados.

// Ver docs/data/spec-importacao-membros.md. Origem MOCK = dados de demonstração,

// rastreáveis via SaasMembro.importacaoId e reversíveis (desfazerImportacao).



model ImportacaoMembros {

  id          String           @id @default(uuid())

  tenantId    String           @map("tenant_id")

  origem      OrigemImportacao

  status      StatusImportacao @default(PENDENTE)

  totalLinhas Int              @default(0) @map("total_linhas")

  importados  Int              @default(0)

  duplicados  Int              @default(0)

  erros       Json?

  criadoPorId String?          @map("criado_por_id")

  criadoEm    DateTime         @default(now()) @map("criado_em")



  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  membros SaasMembro[]



  @@index([tenantId, criadoEm])

  @@map("saas_importacoes_membros")

}



enum OrigemImportacao {

  CSV

  BOT

  DISCORD

  MOCK

}



enum StatusImportacao {

  PENDENTE

  PROCESSANDO

  CONCLUIDA

  ERRO

}



// ─── SÓCIOS / CARTEIRINHAS ───────────────────────────────────────────────────



model SaasSocio {

  id          String   @id @default(uuid())

  tenantId    String   @map("tenant_id")

  userId      String   @map("user_id")

  numeroSocio Int      @map("numero_socio")

  nome        String

  validade    DateTime

  criadoEm    DateTime @default(now()) @map("criado_em")

  discordId   String?  @map("discord_id")

  /// Segredo opaco para QR verificável (HMAC com AUTH_SECRET).

  qrToken     String?  @unique @map("qr_token")

  qrEmitidoEm DateTime? @map("qr_emitido_em")



  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  user   User   @relation(fields: [userId], references: [id])



  @@unique([tenantId, numeroSocio])

  @@unique([tenantId, userId])

  @@map("saas_socios")

}



// ─── PLANOS DE ASSOCIAÇÃO + COBRANÇAS (não confundir com Tenant.plano SaaS) ───

// Ver docs/product/plano-paridade-concorrentes.md Fase A.



model PlanoAssociacao {

