enum StatusPedido {

  PENDENTE

  CONFIRMADO

  CANCELADO

  ENTREGUE

}



// ─── COMUNICADOS OFICIAIS ──────────────────────────────────────────────────

// Distintos de Post (mural/comunidade): nem todo post comunitário é

// comunicado oficial. Publicação gated por ANNOUNCEMENTS_PUBLISH (não por

// COMMUNITY_MANAGE, que segue governando só posts locais).



model Announcement {

  id       String @id @default(uuid())

  tenantId String @map("tenant_id")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  autorId  String @map("autor_id")

  autor    User   @relation(fields: [autorId], references: [id])



  titulo     String

  corpo      String

  prioridade PrioridadeComunicado @default(NORMAL)

  fixado     Boolean              @default(false)



  publicadoEm  DateTime @default(now()) @map("publicado_em")

  criadoEm     DateTime @default(now()) @map("criado_em")

  atualizadoEm DateTime @updatedAt @map("atualizado_em")



  leituras AnnouncementRead[]

  reposts    Post[]



  @@index([tenantId])

  @@index([tenantId, publicadoEm])

  @@map("saas_announcements")

}



enum PrioridadeComunicado {

  NORMAL

  IMPORTANTE

  URGENTE

}



/// Rastreio de leitura por associado — usado para saber quem já viu um

/// comunicado oficial (não se aplica a Post/mural local).

model AnnouncementRead {

  id             String @id @default(uuid())

  announcementId String @map("announcement_id")

  userId         String @map("user_id")



  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)



  lidoEm DateTime @default(now()) @map("lido_em")



  @@unique([announcementId, userId])

  @@index([userId])

  @@map("saas_announcement_reads")

}



// ─── AFILIAÇÃO GLOBAL (time apoiado) ─────────────────────────────────────────



model Afiliacao {

  id             String            @id @default(uuid())

  nome           String

  apelido        String?

  slug           String?           @unique

  serie          SerieCampeonato?

  escudoUrl      String?           @map("escudo_url")

  cidade         String?

  estado         String?

  apiExternalId  String?           @map("api_external_id")

  /// Estimativa pública de torcedores (seed offline — nunca API em runtime).

  torcedoresEstimados      Int?                     @map("torcedores_estimados")

  torcedoresEstimadosFonte String?                  @map("torcedores_estimados_fonte")

  /// IBOPE_DIGITAL = total publicado no Ranking Digital; LIMITE_ATE = fora do Top 50 (teto conservador).

  torcedoresEstimadosTipo  TorcedoresEstimadosTipo? @map("torcedores_estimados_tipo")

  criadoEm       DateTime          @default(now()) @map("criado_em")



  tenants            Tenant[]

  partidas           Partida[]

  noticias           Noticia[]

  torcedores         PerfilTorcedor[]

  rivalClubeA        RivalidadeClube[]  @relation("RivalClubeA")

  rivalClubeB        RivalidadeClube[]  @relation("RivalClubeB")

  torcidasConhecidas TorcidaConhecida[]



  @@map("saas_afiliacoes")

}



/// Catálogo nacional de torcidas organizadas conhecidas (fora da plataforma).

/// Dataset gerado por scraper (`src/data/torcidas-conhecidas.js`); usado no

/// onboarding como referência informativa por clube (Afiliacao).

model TorcidaConhecida {

  id                String   @id @default(uuid())

  nome              String   // nome completo (fiel à fonte)

  titulo            String?  // versão curta/legível p/ exibição (sem prefixo)

  slug              String   @unique

  afiliacaoId       String?  @map("afiliacao_id")

  clubeNomeOriginal String?  @map("clube_nome_original")

  fundacao          String?

  sede              String?

  subsedes          String?

  lema              String?

  siteOficial       String?  @map("site_oficial")

  cidade            String?

  uf                String?

  logoUrl           String?  @map("logo_url")

  fonteUrl          String?  @map("fonte_url")

  ativa             Boolean  @default(true)

  criadoEm          DateTime @default(now()) @map("criado_em")

  atualizadoEm      DateTime @updatedAt @map("atualizado_em")



  afiliacao Afiliacao?       @relation(fields: [afiliacaoId], references: [id], onDelete: SetNull)

  perfis    PerfilTorcedor[]

  tenant    Tenant?



  @@index([afiliacaoId])

  @@map("saas_torcidas_conhecidas")

}



enum TorcedoresEstimadosTipo {

  IBOPE_DIGITAL

  LIMITE_ATE

}



enum SerieCampeonato {

  A

  B

  C

  D

  ESTADUAL

  OUTRA

}



// ─── PERFIL GLOBAL DE TORCEDOR (independe de tenant) ─────────────────────────



model PerfilTorcedor {

  id                    String    @id @default(uuid())

  userId                String    @unique @map("user_id")

  afiliacaoId           String?   @map("afiliacao_id") // clube que torce

  torcidaConhecidaId    String?   @map("torcida_conhecida_id") // organizada conhecida (fora da plataforma)

  regiao                String?   // cidade/estado do torcedor

  bio                   String?

  onboardingConcluidoEm DateTime? @map("onboarding_concluido_em")

  criadoEm              DateTime  @default(now()) @map("criado_em")

  atualizadoEm          DateTime  @updatedAt @map("atualizado_em")



  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  afiliacao        Afiliacao?        @relation(fields: [afiliacaoId], references: [id], onDelete: SetNull)

  torcidaConhecida TorcidaConhecida? @relation(fields: [torcidaConhecidaId], references: [id], onDelete: SetNull)



  @@index([afiliacaoId])

  @@index([torcidaConhecidaId])

  @@map("saas_perfis_torcedor")

}



// ─── RIVALIDADES (par canônico: sempre gravar com aId < bId) ─────────────────



model RivalidadeClube {

  id           String   @id @default(uuid())

