/// Artigo editorial da torcida/unidade — nunca da imprensa (isso é Noticia).
/// tenantId obrigatório: unidade não vaza para Sede nem irmã.
model ArtigoPortal {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  autorId  String @map("autor_id")

  titulo   String
  resumo   String?
  corpo    String
  capaUrl  String? @map("capa_url")

  origem       ArtigoOrigem        @default(OFICIAL)
  status       ArtigoPortalStatus  @default(RASCUNHO)
  publicadoEm  DateTime?           @map("publicado_em")
  criadoEm     DateTime            @default(now()) @map("criado_em")
  atualizadoEm DateTime            @updatedAt @map("atualizado_em")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  autor  User   @relation(fields: [autorId], references: [id])

  @@index([tenantId, status, publicadoEm])
  @@map("saas_artigos_portal")
}

/// Tópico de fórum. CLUBE = afiliacaoId; TORCIDA = tenantId. XOR no app.
model ForumTopico {
  id          String @id @default(uuid())
  escopo      ForumEscopo
  tenantId    String?     @map("tenant_id")
  afiliacaoId String?     @map("afiliacao_id")
  autorId     String      @map("autor_id")

  titulo          String
  corpo           String
  /// Anexos do composer (mesmo formato de Post.midiaUrls).
  midiaUrls       String[] @default([]) @map("midia_urls")
  visitas         Int     @default(0)
  respostasCount  Int     @default(0) @map("respostas_count")
  gostei          Int     @default(0)
  naoGostei       Int     @default(0) @map("nao_gostei")
  fixado          Boolean @default(false)
  status          ForumTopicoStatus @default(VISIVEL)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  tenant    Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  afiliacao Afiliacao?     @relation(fields: [afiliacaoId], references: [id], onDelete: Cascade)
  autor     User           @relation(fields: [autorId], references: [id])
  respostas ForumResposta[]

  @@index([tenantId, status, atualizadoEm])
  @@index([afiliacaoId, status, atualizadoEm])
  @@map("saas_forum_topicos")
}

model ForumResposta {
  id        String  @id @default(uuid())
  topicoId  String  @map("topico_id")
  autorId   String  @map("autor_id")
  parentId  String? @map("parent_id")
  conteudo  String
  oculto    Boolean  @default(false)
  criadoEm  DateTime @default(now()) @map("criado_em")

  topico  ForumTopico   @relation(fields: [topicoId], references: [id], onDelete: Cascade)
  autor   User          @relation(fields: [autorId], references: [id], onDelete: Cascade)
  parent  ForumResposta?  @relation("ForumRespostaThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies ForumResposta[] @relation("ForumRespostaThread")

  @@index([topicoId, criadoEm])
  @@map("saas_forum_respostas")
}

/// Voto +1/−1 em artigo, notícia (card nosso), tópico ou resposta.
model PracaVoto {
  id       String        @id @default(uuid())
