// ─── FINANCEIRO (livro-caixa operacional) ─────────────────────────────────────

// MVP: lançamentos manuais de receita/despesa por tenant. Sem conciliação bancária,

// mensalidade recorrente automática ou inadimplência (fases seguintes).

// Sensibilidade: RESTRITO — só quem tem finance:view / finance:manage.



model FinanceiroLancamento {

  id       String @id @default(uuid())

  tenantId String @map("tenant_id")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)



  tipo      TipoFinanceiroLancamento

  categoria CategoriaFinanceiroLancamento

  /// Sempre positivo; o sinal vem de `tipo` (RECEITA / DESPESA).

  valor     Decimal                     @db.Decimal(12, 2)

  descricao String

  /// Data de competência (quando entrou/saiu o dinheiro).

  data      DateTime

  observacao String?



  /// Rateio por área: opcional e sem migração de dado legado. Responde
  /// "quanto o Social gastou" sem depender de `categoria`.
  departamentoId String?       @map("departamento_id")

  departamento   Departamento? @relation("FinanceiroLancamentoDepartamento", fields: [departamentoId], references: [id], onDelete: SetNull)

  /// Custo/receita de um projeto (ex.: Festa das Crianças). Alimenta o
  /// realizado × orçamento previsto do projeto.
  projetoId      String?       @map("projeto_id")

  projeto        Projeto?      @relation(fields: [projetoId], references: [id], onDelete: SetNull)



  criadoPorId String   @map("criado_por_id")

  criadoPor   User     @relation("FinanceiroLancamentoCriadoPor", fields: [criadoPorId], references: [id])

  criadoEm    DateTime @default(now()) @map("criado_em")

  atualizadoEm DateTime @updatedAt @map("atualizado_em")



  @@index([tenantId, data])

  @@index([tenantId, tipo, data])

  @@index([tenantId, categoria])

  @@index([tenantId, departamentoId, data])

  @@index([projetoId])

  @@map("saas_financeiro_lancamentos")

}



enum TipoFinanceiroLancamento {

  RECEITA

  DESPESA

}



enum CategoriaFinanceiroLancamento {

  MENSALIDADE

  LOJA

  EVENTO

  CARAVANA

  PATRIMONIO

  BAR

  DOACAO

  OUTROS

}



// ─── PATRIMÔNIO (inventário) ─────────────────────────────────────────────────

// MVP: itens físicos da torcida (instrumentos, bandeirões, etc.).

// Baixa = status BAIXADO (não apaga o histórico operacional).

// Sensibilidade: RESTRITO — patrimony:view / patrimony:manage.



model PatrimonioItem {

  id       String @id @default(uuid())

  tenantId String @map("tenant_id")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)



  nome         String

  categoria    CategoriaPatrimonioItem

  status       StatusPatrimonioItem @default(DISPONIVEL)

  quantidade   Int                  @default(1)

  localizacao  String?

  /// Valor estimado unitário (opcional) — prestação de contas informal.

  valorEstimado Decimal? @map("valor_estimado") @db.Decimal(12, 2)

  observacao   String?

  /// Foto de catálogo (Cloudinary). Distinta das evidências de empréstimo
  /// (`fotoSaidaUrl` / `fotoGuardaUrl` em PatrimonioEmprestimo).
  fotoUrl String? @map("foto_url")

  /// Extensões por categoria, sem tabela nova. Hoje: `meta.vistoria` do
  /// departamento de Bandeiras (medidas, mastro, órgão, validade da
  /// liberação) — ver `packages/types/src/patrimonio.js`.
  meta Json?

  /// Frente do departamento Patrimônio (instrumentos / bandeirões / sede).
  areaId String? @map("area_id")

  area   DepartamentoArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)



  responsavelId String? @map("responsavel_id")

  responsavel   User?   @relation("PatrimonioItemResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)



  criadoPorId  String   @map("criado_por_id")

  criadoPor    User     @relation("PatrimonioItemCriadoPor", fields: [criadoPorId], references: [id])

  criadoEm     DateTime @default(now()) @map("criado_em")

  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  emprestimos PatrimonioEmprestimo[]



  @@index([tenantId, status])

  @@index([tenantId, categoria])

  @@index([tenantId, nome])

  @@index([areaId])

  @@map("saas_patrimonio_itens")

}



/// Empréstimo com evidência fotográfica (saída + guarda na devolução).
/// Colaborador conclui sozinho; gestor audita e pode marcar dano.
model PatrimonioEmprestimo {

  id       String @id @default(uuid())

  tenantId String @map("tenant_id")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  itemId String @map("item_id")

  item   PatrimonioItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  userId String @map("user_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status StatusPatrimonioEmprestimo @default(ABERTO)

  /// Obrigatória na retirada.
  fotoSaidaUrl String @map("foto_saida_url")

  /// Obrigatória na devolução (como ficou guardado).
  fotoGuardaUrl String? @map("foto_guarda_url")

  observacao String?

  danoReportado   Boolean @default(false) @map("dano_reportado")

  danoObservacao  String? @map("dano_observacao")

  abertoEm     DateTime  @default(now()) @map("aberto_em")

  devolvidoEm  DateTime? @map("devolvido_em")

  @@index([tenantId, status, abertoEm])

  @@index([itemId, status])

  @@index([userId, status])

  @@map("saas_patrimonio_emprestimos")

}



enum CategoriaPatrimonioItem {

  INSTRUMENTO

  BANDEIRA

  UNIFORME

  MOBILIARIO

  ELETRONICO

  ESPACO

  OUTROS

}



enum StatusPatrimonioItem {

  DISPONIVEL

  EM_USO

  MANUTENCAO

  BAIXADO

}



enum StatusPatrimonioEmprestimo {

  ABERTO

  DEVOLVIDO

  COM_DANO

}



// ─── BAR (PDV da sede/subsede/PDE) ───────────────────────────────────────────

// Catálogo, vendas e estoque isolados por `tenantId` + `sedeId`.

// Cada torcida (tenant) tem seu bar; dentro dela, cada unidade (SEDE /

// SUBSEDE / PONTO_ENCONTRO) tem catálogo e estoque próprios.

// Integra com o livro-caixa via `financeiroLancamentoId` (categoria BAR).



model BarCategoria {

  id       String @id @default(uuid())

  tenantId String @map("tenant_id")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)



  /// Unidade dona deste catálogo (SEDE / SUBSEDE / PDE). Isola estoque entre unidades.

  sedeId String @map("sede_id")

  sede   Sede   @relation(fields: [sedeId], references: [id], onDelete: Cascade)



  nome  String

  slug  String

  ordem Int     @default(0)

  ativo Boolean @default(true)



  criadoEm     DateTime @default(now()) @map("criado_em")

  atualizadoEm DateTime @updatedAt @map("atualizado_em")



  produtos BarProduto[]



  @@unique([tenantId, sedeId, slug])

  @@index([tenantId, sedeId])

  @@map("saas_bar_categorias")

}



model BarProduto {

  id       String @id @default(uuid())

  tenantId String @map("tenant_id")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)



  sedeId String @map("sede_id")

  sede   Sede   @relation(fields: [sedeId], references: [id], onDelete: Cascade)



  categoriaId String?       @map("categoria_id")

  categoria   BarCategoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)



  nome      String

  descricao String?

  preco     Decimal @db.Decimal(10, 2)

  /// Custo médio ponderado por entradas de estoque — base do lucro estimado.

  custoMedio Decimal @default(0) @map("custo_medio") @db.Decimal(10, 2)



  estoque       Int     @default(0)

  estoqueMinimo Int?    @map("estoque_minimo")

  imagemUrl     String? @map("imagem_url")

  ativo         Boolean @default(true)

  destaque      Boolean @default(false)

  ordem         Int     @default(0)



  criadoPorId String? @map("criado_por_id")

  criadoPor   User?   @relation("BarProdutoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)



  criadoEm     DateTime @default(now()) @map("criado_em")

  atualizadoEm DateTime @updatedAt @map("atualizado_em")



  vendaItens    BarVendaItem[]

  movimentacoes BarMovimentacaoEstoque[]



  @@index([tenantId, sedeId, ativo])

  @@index([categoriaId])

  @@map("saas_bar_produtos")

}



model BarVenda {

  id       String @id @default(uuid())

  tenantId String @map("tenant_id")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)



  sedeId String @map("sede_id")

  sede   Sede   @relation(fields: [sedeId], references: [id], onDelete: Cascade)



  /// Comanda à qual este lançamento pertence (null = venda avulsa / legado).
  comandaId String?     @map("comanda_id")
  comanda   BarComanda? @relation(fields: [comandaId], references: [id], onDelete: SetNull)

  /// Turno de caixa em que a venda foi registrada (null = legado / sem turno).
  turnoId String?       @map("turno_id")
  turno   BarCaixaTurno? @relation(fields: [turnoId], references: [id], onDelete: SetNull)

  operadorId String @map("operador_id")

  operador   User   @relation("BarVendaOperador", fields: [operadorId], references: [id], onDelete: Cascade)



  subtotal Decimal @db.Decimal(10, 2)

  desconto Decimal @default(0) @db.Decimal(10, 2)

  total    Decimal @db.Decimal(10, 2)



  /// Null em lançamentos EM_COMANDA — quem paga é a comanda.
  metodoPagamento MetodoPagamentoBar? @map("metodo_pagamento")

  status          StatusVendaBar      @default(PENDENTE)



  gatewayProvider   String?   @map("gateway_provider")

  gatewayExternalId String?   @map("gateway_external_id")

  pixCopiaCola      String?   @map("pix_copia_cola")

  pagoEm            DateTime? @map("pago_em")



  /// Lançamento gerado no livro-caixa (categoria BAR) quando a venda é paga.

  financeiroLancamentoId String? @map("financeiro_lancamento_id")

  /// Lançamento DESPESA de estorno (quando status = ESTORNADA).
  financeiroEstornoLancamentoId String? @map("financeiro_estorno_lancamento_id")
  observacao             String?



  /// Rastreabilidade do estorno (Feature 5 — auditoria de estornos anômalos).
  estornadoPorId String?   @map("estornado_por_id")
  estornadoPor   User?     @relation("BarVendaEstornadoPor", fields: [estornadoPorId], references: [id], onDelete: SetNull)
  estornadoEm    DateTime? @map("estornado_em")
  motivoEstorno  String?   @map("motivo_estorno")



  criadoEm DateTime @default(now()) @map("criado_em")



  itens         BarVendaItem[]

  movimentacoes BarMovimentacaoEstoque[]

  fiado         BarFiado?



  @@index([tenantId, sedeId, criadoEm])

  @@index([tenantId, sedeId, status])

  @@index([comandaId])

  @@index([turnoId])
  @@index([gatewayExternalId])

  @@map("saas_bar_vendas")

}



model BarVendaItem {

  id      String   @id @default(uuid())

  vendaId String   @map("venda_id")

  venda   BarVenda @relation(fields: [vendaId], references: [id], onDelete: Cascade)



  produtoId String?     @map("produto_id")

  produto   BarProduto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)



  /// Snapshot do nome no momento da venda (produto pode ser removido depois).

  produtoNome String  @map("produto_nome")

  quantidade  Int

  precoUnit   Decimal @map("preco_unit") @db.Decimal(10, 2)

  custoUnit   Decimal @default(0) @map("custo_unit") @db.Decimal(10, 2)

  total       Decimal @db.Decimal(10, 2)



  @@index([vendaId])

  @@index([produtoId])

  @@map("saas_bar_venda_itens")

}



model BarFornecedor {

  id       String @id @default(uuid())

  tenantId String @map("tenant_id")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)



  nome        String

  contato     String?

  documento   String?

  observacao  String?

  ativo       Boolean @default(true)



  criadoEm DateTime @default(now()) @map("criado_em")



  movimentacoes BarMovimentacaoEstoque[]



  @@index([tenantId, ativo])

  @@map("saas_bar_fornecedores")

}



model BarMovimentacaoEstoque {

  id       String @id @default(uuid())

  tenantId String @map("tenant_id")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)



  sedeId String @map("sede_id")

  sede   Sede   @relation(fields: [sedeId], references: [id], onDelete: Cascade)



  produtoId String     @map("produto_id")

  produto   BarProduto @relation(fields: [produtoId], references: [id], onDelete: Cascade)



  tipo       TipoMovEstoqueBar

  /// Sempre positiva; a direção vem de `tipo` (ENTRADA / SAIDA / AJUSTE).

  quantidade Int

  custoTotal Decimal? @map("custo_total") @db.Decimal(10, 2)

  motivo     String?



  vendaId String?   @map("venda_id")

  venda   BarVenda? @relation(fields: [vendaId], references: [id], onDelete: SetNull)



  /// Fornecedor da compra de insumo (só relevante para ENTRADA).

  fornecedorId String?        @map("fornecedor_id")

  fornecedor   BarFornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)



  /// Lançamento de despesa no livro-caixa quando a entrada tem custo.

  financeiroLancamentoId String? @map("financeiro_lancamento_id")



  operadorId String? @map("operador_id")

  operador   User?   @relation("BarMovimentacaoOperador", fields: [operadorId], references: [id], onDelete: SetNull)



  criadoEm DateTime @default(now()) @map("criado_em")



  @@index([tenantId, sedeId, produtoId, criadoEm])

  @@map("saas_bar_estoque_mov")

}



enum MetodoPagamentoBar {

  PIX

  DINHEIRO

  CARTAO_DEBITO

  CARTAO_CREDITO

  FIADO

}



enum StatusVendaBar {

  PENDENTE

  PAGA

  /// Lançamento em comanda: estoque baixado, receita ainda não gerada.
  EM_COMANDA

  CANCELADA

  ESTORNADA
}



enum TipoMovEstoqueBar {

  ENTRADA

  SAIDA

  AJUSTE

}


/// Turno de caixa do bar por unidade (SEDE/SUBSEDE/PDE).
/// No máximo um turno aberto por unidade (fechadoEm = null) — enforced na aplicação.
model BarCaixaTurno {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sedeId String @map("sede_id")
  sede   Sede   @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  abertoEm     DateTime  @default(now()) @map("aberto_em")
  fechadoEm    DateTime? @map("fechado_em")
  abertoPorId  String    @map("aberto_por_id")
  abertoPor    User      @relation("BarCaixaTurnoAbertoPor", fields: [abertoPorId], references: [id])
  fechadoPorId String?   @map("fechado_por_id")
  fechadoPor   User?     @relation("BarCaixaTurnoFechadoPor", fields: [fechadoPorId], references: [id])

  /// Retirada de dinheiro do caixa durante/no fechamento (sempre ≥ 0).
  sangria         Decimal  @default(0) @db.Decimal(10, 2)
  /// Dinheiro físico contado no fechamento (null enquanto aberto).
  dinheiroContado Decimal? @map("dinheiro_contado") @db.Decimal(10, 2)
  observacao      String?

  /// Dinheiro esperado calculado no fechamento (base para a diferença/alerta).
  dinheiroEsperado Decimal? @map("dinheiro_esperado") @db.Decimal(10, 2)
  /// diferenca = dinheiroContado - dinheiroEsperado (pode ser negativa).
  diferenca        Decimal? @db.Decimal(10, 2)
  /// true quando |diferenca| ultrapassa o limiar de divergência (Feature 3).
  divergenciaAlta  Boolean  @default(false) @map("divergencia_alta")

  criadoEm DateTime @default(now()) @map("criado_em")

  vendas BarVenda[]

  comandasAbertura   BarComanda[]          @relation("BarComandaTurnoAbertura")
  comandasFechamento BarComanda[]          @relation("BarComandaTurnoFechamento")
  comandaPagamentos  BarComandaPagamento[]

  @@index([tenantId, sedeId, fechadoEm])
  @@map("saas_bar_caixa_turnos")
}



/// Conta aberta do bar (comanda) — acumula lançamentos (BarVenda EM_COMANDA)
/// e fecha com um ou mais pagamentos. Substitui o fluxo de Fiado.
/// Ver docs/data/modulo-bar-comanda.md.
model BarComanda {

  id       String @id @default(uuid())

  tenantId String @map("tenant_id")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)



  sedeId String @map("sede_id")

  sede   Sede   @relation(fields: [sedeId], references: [id], onDelete: Cascade)



  /// Nº da comanda física / mesa / apelido. Unicidade entre ABERTA da unidade
  /// é checagem de aplicação (índice parcial opcional).
  codigo String



  titularUserId String? @map("titular_user_id")

  titularUser   User?   @relation("BarComandaTitular", fields: [titularUserId], references: [id], onDelete: SetNull)

  titularMembroId String?     @map("titular_membro_id")

  titularMembro   SaasMembro? @relation(fields: [titularMembroId], references: [id], onDelete: SetNull)

  /// Snapshot do nome (membro ou avulso). Sempre preenchido.
  titularNome String @map("titular_nome")

  tipo TipoTitularComandaBar



  status StatusComandaBar



  /// Teto de consumo; null = usa o padrão da unidade.
  limite Decimal? @db.Decimal(10, 2)

  total     Decimal @default(0) @db.Decimal(10, 2)

  totalPago Decimal @default(0) @map("total_pago") @db.Decimal(10, 2)

  desconto  Decimal @default(0) @db.Decimal(10, 2)



  turnoAberturaId String?       @map("turno_abertura_id")

  turnoAbertura   BarCaixaTurno? @relation("BarComandaTurnoAbertura", fields: [turnoAberturaId], references: [id], onDelete: SetNull)

  turnoFechamentoId String?       @map("turno_fechamento_id")

  turnoFechamento   BarCaixaTurno? @relation("BarComandaTurnoFechamento", fields: [turnoFechamentoId], references: [id], onDelete: SetNull)



  abertaEm    DateTime @map("aberta_em")

  abertaPorId String   @map("aberta_por_id")

  abertaPor   User     @relation("BarComandaAbertaPor", fields: [abertaPorId], references: [id], onDelete: Cascade)

  fechadaEm    DateTime? @map("fechada_em")

  fechadaPorId String?   @map("fechada_por_id")

  fechadaPor   User?     @relation("BarComandaFechadaPor", fields: [fechadaPorId], references: [id], onDelete: SetNull)



  vencimento DateTime?

  pagoEm     DateTime? @map("pago_em")

  canceladaEm         DateTime? @map("cancelada_em")

  motivoCancelamento  String?   @map("motivo_cancelamento")

  observacao String?



  criadoEm DateTime @default(now()) @map("criado_em")



  vendas     BarVenda[]

  pagamentos BarComandaPagamento[]



  @@index([tenantId, sedeId, status])

  @@index([tenantId, sedeId, codigo])

  @@index([titularUserId])

  @@index([titularMembroId])

  @@map("saas_bar_comandas")

}



model BarComandaPagamento {

  id String @id @default(uuid())



  comandaId String     @map("comanda_id")

  comanda   BarComanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)



  metodoPagamento MetodoPagamentoBar @map("metodo_pagamento")

  valor           Decimal            @db.Decimal(10, 2)



  recebidoEm DateTime @map("recebido_em")



  turnoId String?       @map("turno_id")

  turno   BarCaixaTurno? @relation(fields: [turnoId], references: [id], onDelete: SetNull)

  operadorId String @map("operador_id")

  operador   User   @relation("BarComandaPagamentoOperador", fields: [operadorId], references: [id], onDelete: Cascade)



  gatewayProvider   String?   @map("gateway_provider")

  gatewayExternalId String?   @map("gateway_external_id")

  pixCopiaCola      String?   @map("pix_copia_cola")

  pagoEm            DateTime? @map("pago_em")



  status StatusPagamentoComandaBar @default(PENDENTE)



  /// Lançamento RECEITA categoria BAR — um por pagamento confirmado.
  financeiroLancamentoId String? @unique @map("financeiro_lancamento_id")



  criadoEm DateTime @default(now()) @map("criado_em")



  @@index([comandaId])

  @@index([turnoId])

  @@index([gatewayExternalId])

  @@map("saas_bar_comanda_pagamentos")

}



enum StatusComandaBar {

  ABERTA

  FECHADA_PAGA

  FECHADA_COM_DEBITO

  QUITADA

  VENCIDA

  CANCELADA

}



enum StatusPagamentoComandaBar {

  PENDENTE

  CONFIRMADO

  CANCELADO

}



enum TipoTitularComandaBar {

  MEMBRO

  AVULSO

}



/// Venda a fiado (crédito) vinculada a um membro — quitação gera o lançamento
/// no livro-caixa só quando o débito é pago (ver docs/data/modulo-bar.md).
model BarFiado {

  id       String @id @default(uuid())

  tenantId String @map("tenant_id")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)



  sedeId String @map("sede_id")

  sede   Sede   @relation(fields: [sedeId], references: [id], onDelete: Cascade)



  vendaId String   @unique @map("venda_id")

  venda   BarVenda @relation(fields: [vendaId], references: [id], onDelete: Cascade)



  /// Devedor (usuário da conta do membro).

  userId String @map("user_id")

  user   User   @relation("BarFiadoDevedor", fields: [userId], references: [id], onDelete: Cascade)



  membroId String?     @map("membro_id")

  membro   SaasMembro? @relation(fields: [membroId], references: [id], onDelete: SetNull)



  valor      Decimal        @db.Decimal(10, 2)

  vencimento DateTime

  status     StatusFiadoBar @default(PENDENTE)



  pagoEm                   DateTime?           @map("pago_em")

  metodoPagamentoQuitacao  MetodoPagamentoBar? @map("metodo_pagamento_quitacao")



  financeiroLancamentoId String? @unique @map("financeiro_lancamento_id")



  criadoPorId String? @map("criado_por_id")

  criadoPor   User?   @relation("BarFiadoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)



  criadoEm DateTime @default(now()) @map("criado_em")



  @@index([tenantId, sedeId, status, vencimento])

  @@index([userId])

  @@index([membroId])

  @@map("saas_bar_fiados")

}



enum StatusFiadoBar {

  PENDENTE

  PAGA

  CANCELADA

  VENCIDA

}
