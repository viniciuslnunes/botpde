// ─── COMUNICADOS OFICIAIS ──────────────────────────────────────────────────

// Distintos de Post (mural/comunidade): nem todo post comunitário é

// comunicado oficial. Publicação gated por ANNOUNCEMENTS_PUBLISH (não por

// COMMUNITY_MANAGE, que segue governando só posts locais).



model Announcement {

  id       String @id @default(uuid())

  tenantId String @map("tenant_id")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  autorId  String @map("autor_id")

  autor    User   @relation(fields: [autorId], references: [id])



  titulo     String

  corpo      String

  prioridade PrioridadeComunicado @default(NORMAL)

  fixado     Boolean              @default(false)



  publicadoEm  DateTime @default(now()) @map("publicado_em")

  criadoEm     DateTime @default(now()) @map("criado_em")

  atualizadoEm DateTime @updatedAt @map("atualizado_em")



  leituras AnnouncementRead[]

  reposts    Post[]



  @@index([tenantId])

  @@index([tenantId, publicadoEm])

  @@map("saas_announcements")

}



enum PrioridadeComunicado {

  NORMAL

  IMPORTANTE

  URGENTE

}



/// Rastreio de leitura por associado — usado para saber quem já viu um

/// comunicado oficial (não se aplica a Post/mural local).

model AnnouncementRead {

  id             String @id @default(uuid())

  announcementId String @map("announcement_id")

  userId         String @map("user_id")



  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)



  lidoEm DateTime @default(now()) @map("lido_em")



  @@unique([announcementId, userId])

  @@index([userId])

  @@map("saas_announcement_reads")

}



// ─── AFILIAÇÃO GLOBAL (time apoiado) ─────────────────────────────────────────



model Afiliacao {

  id             String            @id @default(uuid())

  nome           String

  apelido        String?

  slug           String?           @unique

  serie          SerieCampeonato?

  escudoUrl      String?           @map("escudo_url")

  cidade         String?

  estado         String?

  apiExternalId  String?           @map("api_external_id")

  /// Estimativa pública de torcedores (seed offline — nunca API em runtime).

  torcedoresEstimados      Int?                     @map("torcedores_estimados")

  torcedoresEstimadosFonte String?                  @map("torcedores_estimados_fonte")

  /// IBOPE_DIGITAL = total publicado no Ranking Digital; PESQUISA = Datafolha x base IBGE;
  /// LIMITE_ATE = fora do Top 50 (teto conservador).

  torcedoresEstimadosTipo  TorcedoresEstimadosTipo? @map("torcedores_estimados_tipo")

  /// ─── Ficha do clube (seed offline; ver docs/knowledge/fontes-dados-clubes.md) ───
  /// Só o ANO: as fontes marcam precisão de ano com 1º de janeiro, e gravar
  /// data cheia inventaria um dia que ninguém publicou.

  fundacaoAno       Int?     @map("fundacao_ano")

  estadio           String?

  estadioCapacidade Int?     @map("estadio_capacidade")

  estadioLat        Float?   @map("estadio_lat")

  estadioLng        Float?   @map("estadio_lng")

  siteOficial       String?  @map("site_oficial")

  /// Cores do clube. `coresFonte` distingue curadoria (`design:CLUBE_PALETAS`) de
  /// derivação automática do escudo (`escudo:cloudinary`) — a segunda é proposta.

  corPrimaria       String?  @map("cor_primaria")

  corSecundaria     String?  @map("cor_secundaria")

  corAcento         String?  @map("cor_acento")

  coresFonte        String?  @map("cores_fonte")

  /// Ids externos estáveis — desempatam homônimos que nome+UF não separa
  /// (Bahia x Bahia de Feira, Democrata GV x Democrata SL).

  wikidataQid       String?  @map("wikidata_qid")

  ogolId            String?  @map("ogol_id")

  /// Ranking Nacional de Clubes da CBF: prova de atividade profissional recente
  /// e critério de relevância para ordenar o catálogo.

  rncPosicao        Int?     @map("rnc_posicao")

  rncPontos         Int?     @map("rnc_pontos")

  rncEdicao         String?  @map("rnc_edicao")

  /// Arquivado (false) sai da seleção de onboarding/switcher sem apagar histórico.
  /// Clube nunca é excluído enquanto tiver vínculo — `Partida`/`Noticia` são Cascade.

  ativo          Boolean           @default(true)

  criadoEm       DateTime          @default(now()) @map("criado_em")

  /// `@default(now())` backfilla as linhas já existentes no `db push`;
  /// `@updatedAt` continua atualizando a cada escrita.
  atualizadoEm   DateTime          @default(now()) @updatedAt @map("atualizado_em")



  tenants            Tenant[]

  partidas           Partida[]

  noticias           Noticia[]

  forumTopicos       ForumTopico[]

  forumScoreSaldos  ForumScoreSaldo[]

  torcedores         PerfilTorcedor[]

  rivalClubeA        RivalidadeClube[]  @relation("RivalClubeA")

  rivalClubeB        RivalidadeClube[]  @relation("RivalClubeB")

  torcidasConhecidas TorcidaConhecida[]



  /// Listagem do catálogo (`/super-admin/clubes`): ordena por nome, faceta por UF/série.

  @@index([nome])

  @@index([rncPontos])

  @@index([estado])

  @@index([serie])

  @@map("saas_afiliacoes")

}



/// Catálogo nacional de torcidas organizadas conhecidas (fora da plataforma).

/// Dataset gerado por scraper (`src/data/torcidas-conhecidas.js`); usado no

/// onboarding como referência informativa por clube (Afiliacao).

model TorcidaConhecida {

  id                String   @id @default(uuid())

  nome              String   // nome completo (fiel à fonte)

  titulo            String?  // versão curta/legível p/ exibição (sem prefixo)

  slug              String   @unique

  afiliacaoId       String?  @map("afiliacao_id")

  clubeNomeOriginal String?  @map("clube_nome_original")

  fundacao          String?

  /// Ano extraído de `fundacao` (a fonte colaborativa grava a data com dia e
  /// mês desconhecidos como curingas, "23/10/1992" e variantes; só o ano é
  /// confiável em toda a base).
  /// NÃO escrever a sequência asterisco-barra aqui: o `///` do Prisma vira
  /// bloco JSDoc no `index.d.ts` gerado, e ela fecha o comentário no meio —
  /// o resto do arquivo passa a ser lido como código e o `tsc` quebra com
  /// "Unterminated regular expression literal" a 60 mil linhas de distância.

  fundacaoAno       Int?     @map("fundacao_ano")

  /// Registro na federação estadual — ver docs/knowledge/contexto-legal.md.

  situacaoRegistro  SituacaoRegistroTorcida @default(DESCONHECIDO) @map("situacao_registro")

  registroFonte     String?  @map("registro_fonte")

  registroEm        DateTime? @map("registro_em")

  sede              String?

  subsedes          String?

  lema              String?

  siteOficial       String?  @map("site_oficial")

  cidade            String?

  uf                String?

  logoUrl           String?  @map("logo_url")

  fonteUrl          String?  @map("fonte_url")

  ativa             Boolean  @default(true)

  criadoEm          DateTime @default(now()) @map("criado_em")

  atualizadoEm      DateTime @updatedAt @map("atualizado_em")



  afiliacao Afiliacao?       @relation(fields: [afiliacaoId], references: [id], onDelete: SetNull)

  perfis    PerfilTorcedor[]

  tenant    Tenant?



  @@index([afiliacaoId])

  @@map("saas_torcidas_conhecidas")

}



enum TorcedoresEstimadosTipo {

  IBOPE_DIGITAL

  /// Pesquisa de opinião (Datafolha) convertida pela base populacional do IBGE.

  PESQUISA

  LIMITE_ATE

}


/// Situação do registro da torcida junto à federação estadual. Ausência da lista
/// NÃO prova inexistência — por isso `SEM_REGISTRO_CONHECIDO`, não "irregular".

enum SituacaoRegistroTorcida {

  REGISTRADA_FEDERACAO

  SEM_REGISTRO_CONHECIDO

  DESCONHECIDO

}


/// Alcance da rivalidade. Só MUNICIPAL e ESTADUAL isolam torcidas: clássico
/// INTERESTADUAL é rivalidade de calendário e apagaria a malha nacional à toa.

enum EscopoRivalidade {

  MUNICIPAL

  ESTADUAL

  INTERESTADUAL

}



enum SerieCampeonato {

  A

  B

  C

  D

  ESTADUAL

  OUTRA

}



