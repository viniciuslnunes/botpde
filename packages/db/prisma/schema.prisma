  /// Lançamento RECEITA LOJA no livro-caixa (quando pedido é confirmado/entregue).
  financeiroLancamentoId String? @unique @map("financeiro_lancamento_id")

  discordId     String? @map("discord_id")

  canalTicketId String? @map("canal_ticket_id")



  criadoEm     DateTime @default(now()) @map("criado_em")

  atualizadoEm DateTime @updatedAt @map("atualizado_em")



