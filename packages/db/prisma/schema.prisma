  salaId     String    @map("sala_id")

  autorId    String    @map("autor_id")

  conteudo   String

  destacada  Boolean   @default(false)

  editadaEm  DateTime? @map("editada_em")

  excluidaEm DateTime? @map("excluida_em")

  criadoEm   DateTime  @default(now()) @map("criado_em")



  sala  SalaReuniao @relation(fields: [salaId], references: [id], onDelete: Cascade)

  autor User        @relation(fields: [autorId], references: [id], onDelete: Cascade)



  @@index([salaId, criadoEm])

  @@index([salaId, destacada])

