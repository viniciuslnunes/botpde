  denunciante  User           @relation("DenunciaMensagemDenunciante", fields: [denuncianteId], references: [id], onDelete: Cascade)

  resolvidoPor User?          @relation("DenunciaMensagemResolvidoPor", fields: [resolvidoPorId], references: [id])



