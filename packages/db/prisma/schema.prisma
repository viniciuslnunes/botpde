model Post {

  id       String @id @default(uuid())

  tenantId String @map("tenant_id")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  autorId  String @map("autor_id")

  autor    User   @relation(fields: [autorId], references: [id])



  titulo      String?

  conteudo    String

  imagemUrl   String?          @map("imagem_url")

  midiaUrls   String[]         @default([]) @map("midia_urls")

  tipo        TipoPost         @default(INSTITUCIONAL)

  visibilidade VisibilidadePost @default(PUBLICO)

  fixado      Boolean          @default(false)

  oculto      Boolean          @default(false)

  /// Post PUBLICO de sócio que também alcança torcedores globais do clube na

  /// Comunidade Nacional, bypassando o gate de follow aprovado. Exige

  /// COMMUNITY_POST_NACIONAL — validado no servidor, nunca só no cliente.

  alcanceNacional Boolean       @default(false) @map("alcance_nacional")



  postOrigemId String? @map("post_origem_id")

  postOrigem   Post?   @relation("Repost", fields: [postOrigemId], references: [id], onDelete: SetNull)

  reposts      Post[]  @relation("Repost")



  comunicadoOrigemId String?       @map("comunicado_origem_id")

  comunicadoOrigem   Announcement? @relation(fields: [comunicadoOrigemId], references: [id], onDelete: SetNull)



  eventoId String? @map("evento_id")

  evento   Evento? @relation(fields: [eventoId], references: [id], onDelete: SetNull)



  conversaId String?    @map("conversa_id")

  conversa   Conversa? @relation(fields: [conversaId], references: [id], onDelete: SetNull)



  criadoEm     DateTime @default(now()) @map("criado_em")

  atualizadoEm DateTime @updatedAt @map("atualizado_em")



  comentarios Comentario[]

  reacoes     Reacao[]

  denuncias   Denuncia[]

  enquete     EnquetePost?

  hashtags    PostHashtag[]

  destaqueItens PerfilDestaqueItem[]

  salvos      PostSalvo[]

  feedTimeline FeedTimeline[]



  @@index([tenantId, criadoEm])

  @@index([tenantId, oculto])

  @@index([autorId, criadoEm])

  @@index([tenantId, tipo, oculto, conversaId, criadoEm])

  @@index([postOrigemId])

  @@index([comunicadoOrigemId])

  @@index([eventoId])

  @@index([conversaId])

  @@map("saas_posts")

}



