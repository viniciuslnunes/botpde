generator client {

  provider = "prisma-client-js"

}



datasource db { 

  provider = "postgresql"

  url      = env("DATABASE_URL")

}



// ═══════════════════════════════════════════════════════════════

// TABELAS EXISTENTES DO BOT (leitura/escrita pelo bot via pg)

// O Prisma pode ler estas tabelas, mas NÃO altera sua estrutura.

// ═══════════════════════════════════════════════════════════════



/// Tabela legada do bot — lida pelo SaaS para exibir dados no portal

model BotMembro {

  id              Int       @id @default(autoincrement())

  discordId       String    @unique @map("discord_id")

  nome            String

  tipo            String // 'socio' ou 'torcedor'

  numeroAssociado String?   @map("numero_associado")

  cidade          String?

  telefone        String?

  idade           Int?

  aprovadoPorId   String?   @map("aprovado_por_id")

  aprovadoPorNome String?   @map("aprovado_por_nome")

  criadoEm        DateTime? @default(now()) @map("criado_em")

  imagemProva     String?   @map("imagem_prova")



  @@map("membros")

}



/// Tabela legada do bot — produtos da loja

model BotProduto {

  id        Int         @id @default(autoincrement())

  nome      String

  tamanhos  String

  preco     Decimal     @db.Decimal(10, 2)

  imagemUrl String?     @map("imagem_url")

  ativo     Boolean?    @default(true)

  criadoEm  DateTime?   @default(now()) @map("criado_em")

  estoque   Json?       @default("{}")

  pedidos   BotPedido[]



  @@map("produtos")

}



/// Tabela legada do bot — pedidos da loja

model BotPedido {

  id            Int         @id @default(autoincrement())

  discordId     String      @map("discord_id")

  discordTag    String?     @map("discord_tag")

  produtoId     Int?        @map("produto_id")

  produtoNome   String?     @map("produto_nome")

  tamanho       String?

  quantidade    Int

  precoUnit     Decimal?    @map("preco_unit") @db.Decimal(10, 2)

  total         Decimal?    @db.Decimal(10, 2)

  status        String?     @default("pendente")

  canalTicketId String?     @map("canal_ticket_id")

  criadoEm      DateTime?   @default(now()) @map("criado_em")

  produto       BotProduto? @relation(fields: [produtoId], references: [id], onDelete: NoAction, onUpdate: NoAction)



  @@map("pedidos")

}



/// Tabela legada do bot — ranking de recrutadores

model BotAprovacao {

  id            Int       @id @default(autoincrement())

  aprovadorId   String    @map("aprovador_id")

  aprovadorNome String?   @map("aprovador_nome")

  candidatoId   String?   @map("candidato_id")

  candidatoNome String?   @map("candidato_nome")

  tipo          String?

  criadoEm      DateTime? @default(now()) @map("criado_em")



  @@map("aprovacoes_recrutamento")

}



/// Tabela legada do bot — configurações persistidas (IDs de mensagens)

model BotConfig {

  key   String  @id

  value String?



  @@map("bot_config")

}



// ═══════════════════════════════════════════════════════════════

// TABELAS DO SAAS — novas, prefixo saas_ para evitar conflitos

// ═══════════════════════════════════════════════════════════════



// ─── TENANTS ────────────────────────────────────────────────────────────────



model Tenant {

  id          String   @id @default(uuid())

  slug        String   @unique

  nome        String

  plano       Plano    @default(FREE)

  corPrimaria String   @default("#7c3aed") @map("cor_primaria")

  logoUrl     String?  @map("logo_url")

  /// Tema visual completo (marca, grade, superfícies claro/escuro). Ver TenantDesignSchema.

  design      Json?    @map("design")

  ativo       Boolean  @default(true)

  criadoEm    DateTime @default(now()) @map("criado_em")



  /// R3 — hierarquia opt-in: quando true, subsedes/PDEs descendentes enxergam a

  /// worktree completa da torcida. Só a raiz SEDE consome este toggle.

  hierarquiaVisivelParaFilhos Boolean @default(false) @map("hierarquia_visivel_para_filhos")

  /// Sede: loja desta torcida aparece no portal dos membros das unidades
  /// (PDE/subsede). Default true — catálogo costuma ser público na web.
  /// Só a raiz SEDE consome este toggle.
  lojaVisivelNasUnidades Boolean @default(true) @map("loja_visivel_nas_unidades")

  /// Sede: agenda (eventos globais) desta torcida aparece no portal dos
  /// membros das unidades. Default false — unidade vê só a própria agenda
  /// até a liderança liberar. Só a raiz SEDE consome este toggle.
  agendaVisivelNasUnidades Boolean @default(false) @map("agenda_visivel_nas_unidades")

  /// Sede: sócios da linhagem podem negociar no brechó com torcidas aliadas.
  /// Default false — presidente liga em Transparência. Só a raiz SEDE consome.
  brechoAliados Boolean @default(false) @map("brecho_aliados")

  /// Sede: memória pública compartilhada com torcidas aliadas (bilateral).
  /// Default false — presidente liga em Transparência. Só a raiz SEDE consome.
  memoriaAliados Boolean @default(false) @map("memoria_aliados")



  // Tenant sintético: container de posts de torcedores globais do clube

  // (Comunidade Nacional). Sem Sede/Role/SaasMembro; nunca listado como torcida real.

  sintetico Boolean @default(false) @map("sintetico")



  // Banco de dados próprio do tenant (null = usa o banco compartilhado)

  // Cada torcida pode ter seu banco isolado quando necessário

  databaseUrl String? @map("database_url")



  discordGuildId String? @unique @map("discord_guild_id")



  afiliacaoId String?     @map("afiliacao_id")

  afiliacao   Afiliacao?  @relation(fields: [afiliacaoId], references: [id], onDelete: SetNull)



  // Vínculo opcional ao catálogo nacional (dados ricos: fundação, lema, sede, site).

  // Tenants pré-criados a partir de TorcidaConhecida referenciam a origem aqui.

  torcidaConhecidaId String?           @unique @map("torcida_conhecida_id")

  torcidaConhecida   TorcidaConhecida? @relation(fields: [torcidaConhecidaId], references: [id], onDelete: SetNull)



  membros           SaasMembro[]

  socios            SaasSocio[]

  produtos          SaasProduto[]

  categoriasLoja    SaasCategoria[]

  cuponsLoja        SaasCupom[]

  carrinhoItens     SaasCarrinhoItem[]

  pedidos           SaasPedido[]

  pedidoTickets     SaasPedidoTicket[]

  brechoLojas            BrechoLoja[]
  brechoAnuncios         BrechoAnuncio[]
  brechoAnunciosOrigem   BrechoAnuncio[] @relation("BrechoAnuncioOrigem")
  brechoInteresses       BrechoInteresse[]
  brechoTrocas           BrechoTroca[]
  denunciasBrecho        DenunciaBrecho[] @relation("DenunciaBrechoTenant")

  sedes             Sede[]

  eventos           Evento[]

  roles             Role[]

  userRoles         UserRole[]

  userPermissions   UserPermission[]

  departamentos     Departamento[]

  userDepartamentos UserDepartamento[]

  departamentoAreas DepartamentoArea[]

  projetos          Projeto[]

  auditLogs         AuditLog[]

  bloqueados        Bloqueado[]

  posts             Post[]

  memoriaFatos      MemoriaFato[]

  advertencias      Advertencia[]

  announcements     Announcement[]

  importacoes       ImportacaoMembros[]

  aliancasOrigem    Alianca[]             @relation("AliancaOrigem")

  aliancasAliado    Alianca[]             @relation("AliancaAliado")

  recomendacoes     RecomendacaoAlianca[]

  perfisMembro      PerfilMembro[]

  seguimentosCtx    Seguimento[]          @relation("SeguimentoContexto")

  salasReuniao      SalaReuniao[]

  denuncias         Denuncia[]

  conversas         Conversa[]

  denunciasMensagem DenunciaMensagem[]    @relation("DenunciaMensagemTenant")

  membroBloqueios   MembroBloqueio[]

  hashtags          Hashtag[]

  perfilDestaques   PerfilDestaque[]

  postSalvos        PostSalvo[]

  momentosStory     MomentoStory[]

  rivalTorcidaA     RivalidadeTorcida[]   @relation("RivalTorcidaA")

  rivalTorcidaB     RivalidadeTorcida[]   @relation("RivalTorcidaB")

  financeiroLancamentos FinanceiroLancamento[]

  patrimonioItens       PatrimonioItem[]

  patrimonioEmprestimos PatrimonioEmprestimo[]

  planosAssociacao      PlanoAssociacao[]

  cobrancasAssociacao   CobrancaAssociacao[]

  barCategorias           BarCategoria[]

  barProdutos             BarProduto[]

  barVendas               BarVenda[]

  barMovimentacoesEstoque BarMovimentacaoEstoque[]

  barCaixaTurnos          BarCaixaTurno[]

  barFornecedores         BarFornecedor[]

  barFiados               BarFiado[]

  barComandas             BarComanda[]

  solicitacoesUnidade     SolicitacaoUnidade[]     @relation("TenantSolicitacoesUnidade")

  solicitacoesReativacao  SolicitacaoReativacaoCanal[] @relation("TenantSolicitacoesReativacao")

  artigosPortal           ArtigoPortal[]

  forumTopicos            ForumTopico[]

  forumScoreSaldos       ForumScoreSaldo[]

  confiancaEventos       ConfiancaEvento[]

  confiancaSaldos        ConfiancaSaldo[]


  /// Canal restrito (R5): por decisão da liderança da unidade, o tenant sai da
  /// malha de INTERAÇÃO (comunidade nacional, aliados, salas, lojas, DMs,
  /// onboarding público, busca). Administração e comunidade internas seguem
  /// intactas, e a cascata institucional da Sede continua descendo.
  /// Nunca ler este campo direto na UI — usar `lib/isolamento.ts`, que desconta
  /// a expiração automática da solicitação de reativação.
  canalRestrito      Boolean   @default(false) @map("canal_restrito")

  canalRestritoDesde DateTime? @map("canal_restrito_desde")

  canalRestritoPorId String?   @map("canal_restrito_por_id")

  /// Convite direto: link que adianta as etapas de clube/torcida/unidade no
  /// onboarding. Para unidade restrita é o único caminho de entrada.
  conviteSlug        String?   @unique @map("convite_slug")

  conviteAtivo       Boolean   @default(false) @map("convite_ativo")


  /// Config: exibir o balanço financeiro consolidado aos associados no portal.

  balancoFinanceiroVisivel Boolean @default(false) @map("balanco_financeiro_visivel")

  /// Quanto detalhe o balanço público mostra (totais / categorias / lançamentos).
  balancoDetalheNivel BalancoDetalheNivel @default(COMPLETO) @map("balanco_detalhe_nivel")

  /// Onboarding SOCIO: exige foto do RG e comprovante de residência (controle/registro).
  /// Desligável em /admin/configuracoes → Cadastro de sócios.
  exigirDocumentosCadastro Boolean @default(true) @map("exigir_documentos_cadastro")

  /// Portal: modal de dados pendentes neste canal/unidade (default ligado).
  solicitarPendenciasCadastro Boolean @default(true) @map("solicitar_pendencias_cadastro")

  /// Só na Sede (raiz): quando true, o valor de `solicitarPendenciasCadastro`
  /// da Sede vale para toda a worktree (subsedes/PDEs ignoram o flag local).
  /// Editável por owner/admin/vice/super-admin na Sede.
  propagarPendenciasCadastroUnidades Boolean @default(false) @map("propagar_pendencias_cadastro_unidades")

  /// Periodicidades oferecidas no onboarding «Já sou sócio».
  /// Vazio = fallback de app (QUADRIMENSAL + ANUAL). Config em /admin/configuracoes.
  periodicidadesOnboarding PeriodicidadePlanoAssociacao[] @default([]) @map("periodicidades_onboarding")

  /// Suporte da plataforma: consentimento DESTA unidade para o super-admin
  /// operar as configurações reservadas ao owner. Isolado por tenant — a Sede
  /// não decide pelas unidades nem vice-versa. Só tem efeito quando a unidade
  /// já tem owner; sem liderança o super-admin opera por padrão (senão a
  /// unidade fica sem quem configure). Nunca ler direto: usar
  /// `lib/suporte-plataforma.ts`.
  suportePlataforma      Boolean   @default(false) @map("suporte_plataforma")

  suportePlataformaDesde DateTime? @map("suporte_plataforma_desde")

  suportePlataformaPorId String?   @map("suporte_plataforma_por_id")

  /// Setor da torcida no estádio do time apoiado. Só a raiz SEDE grava;
  /// unidades herdam na leitura (`resolverSetorArquibancada`). Copy: sempre
  /// “Setor Norte/Sul/Leste/Oeste” — nunca “Gol Norte”. Ver docs/data/setor-arquibancada.md.
  setorArquibancada      SetorArquibancada? @map("setor_arquibancada")
  setorArquibancadaGeral Boolean            @default(false) @map("setor_arquibancada_geral")
  setorArquibancadaNome  String?            @map("setor_arquibancada_nome")
  setorArquibancadaPortao String?           @map("setor_arquibancada_portao")

  @@map("saas_tenants")

}

/// Cabeceira/lateral onde a organizada se concentra. Null = ainda não cadastrado.
enum SetorArquibancada {
  NORTE
  SUL
  LESTE
  OESTE
}



enum BalancoDetalheNivel {
  TOTAIS
  CATEGORIAS
  COMPLETO
}

enum Plano {

  FREE

  BASIC

  PREMIUM

}



// ─── USUÁRIOS ────────────────────────────────────────────────────────────────



model User {

  id           String    @id @default(uuid())

  email        String?   @unique

  nome         String?

  /// Handle único global (@usuario) — referência pública no feed/perfil.

  nickname     String?   @unique

  avatarUrl    String?   @map("avatar_url")

  criadoEm     DateTime  @default(now()) @map("criado_em")

  discordId    String?   @unique @map("discord_id")

  googleId     String?   @unique @map("google_id")

  // Hash bcrypt — só usuários que se cadastraram por e-mail/senha têm valor.

  // Nunca preenchido para contas só-OAuth (Discord/Google).

  senhaHash    String?   @map("senha_hash")

  consentidoEm DateTime? @map("consentido_em")

  /// Última atividade na plataforma (heartbeat throttled) — base de "online" no onboarding.

  ultimoAcessoEm DateTime? @map("ultimo_acesso_em")



  userRoles            UserRole[]

  userPermissions      UserPermission[]

  userDepartamentos    UserDepartamento[]

  departamentosGeridos DepartamentoGestor[]

  departamentoAreas    DepartamentoAreaMembro[]

  projetosResponsavel  Projeto[]               @relation("ProjetoResponsavel")

  projetosParticipante ProjetoParticipante[]

  membros              SaasMembro[]

  socios               SaasSocio[]

  pedidos              SaasPedido[]

  carrinhoItens        SaasCarrinhoItem[]

  eventosRsvp          EventoRsvp[]

  sedesResponsavel     Sede[]               @relation("SedeResponsavel")

  posts                Post[]

  memoriaFatos         MemoriaFato[]

  memoriaFatosAprovados MemoriaFato[]       @relation("MemoriaFatoAprovador")

  auditLogs            AuditLog[]           @relation("AuditAtor")

  announcements        Announcement[]

  announcementReads    AnnouncementRead[]

  perfisMembro         PerfilMembro[]

  seguindo             Seguimento[]         @relation("SeguimentoSeguidor")

  seguidores           Seguimento[]         @relation("SeguimentoSeguido")

  comentarios          Comentario[]

  reacoes              Reacao[]

  denuncias            Denuncia[]

  denunciasResolvidas  Denuncia[]           @relation("DenunciaResolvidoPor")

  notificacoes         Notificacao[]

  notificacoesAtor     Notificacao[]        @relation("NotificacaoAtor")

  noticiasCuradas      Noticia[]

  aliancasPropostas    Alianca[]            @relation("AliancaPropostaPor")

  aliancasConfirmadas  Alianca[]            @relation("AliancaConfirmadaPor")

  salasHospedadas      SalaReuniao[]

  participacoesReuniao ParticipanteReuniao[]

  mensagensReuniao     MensagemReuniao[]

  enquetesReuniao      EnqueteReuniao[]

  votosEnqueteReuniao  VotoEnqueteReuniao[]



  conversasCriadas            Conversa[]         @relation("ConversaCriadaPor")

  membroConversas             MembroConversa[]

  mensagensDiretas            MensagemDireta[]   @relation("MensagemDiretaAutor")

  bloqueiosFeitos             BloqueioUsuario[]  @relation("BloqueioBloqueador")

  bloqueiosRecebidos          BloqueioUsuario[]  @relation("BloqueioBloqueado")

  membroBloqueios             MembroBloqueio[]

  denunciasMensagem           DenunciaMensagem[] @relation("DenunciaMensagemDenunciante")

  denunciasMensagemResolvidas DenunciaMensagem[] @relation("DenunciaMensagemResolvidoPor")

  votosEnquetePost            VotoEnquetePost[]

  perfilDestaques             PerfilDestaque[]

  postsSalvos                 PostSalvo[]

  feedTimeline                FeedTimeline[]

  momentosStory               MomentoStory[]

  perfilTorcedor              PerfilTorcedor?

  financeiroLancamentosCriados FinanceiroLancamento[] @relation("FinanceiroLancamentoCriadoPor")

  patrimonioItensCriados       PatrimonioItem[]       @relation("PatrimonioItemCriadoPor")

  patrimonioItensResponsavel   PatrimonioItem[]       @relation("PatrimonioItemResponsavel")

  patrimonioEmprestimos        PatrimonioEmprestimo[]

  cobrancasAssociacao          CobrancaAssociacao[]

  cobrancasAssociacaoCriadas   CobrancaAssociacao[]   @relation("CobrancaAssociacaoCriadoPor")

  barProdutosCriados           BarProduto[]           @relation("BarProdutoCriadoPor")

  barVendasOperadas            BarVenda[]             @relation("BarVendaOperador")

  barMovimentacoesEstoque      BarMovimentacaoEstoque[] @relation("BarMovimentacaoOperador")

  barCaixaTurnosAbertos        BarCaixaTurno[]        @relation("BarCaixaTurnoAbertoPor")
  barCaixaTurnosFechados       BarCaixaTurno[]        @relation("BarCaixaTurnoFechadoPor")

  barVendasEstornadas          BarVenda[]             @relation("BarVendaEstornadoPor")

  barFiadosDevidos             BarFiado[]             @relation("BarFiadoDevedor")

  barFiadosCriados             BarFiado[]             @relation("BarFiadoCriadoPor")

  barComandasTitular           BarComanda[]           @relation("BarComandaTitular")

  barComandasAbertas           BarComanda[]           @relation("BarComandaAbertaPor")

  barComandasFechadas          BarComanda[]           @relation("BarComandaFechadaPor")

  barComandaPagamentos         BarComandaPagamento[]  @relation("BarComandaPagamentoOperador")

  solicitacoesUnidadeFeitas    SolicitacaoUnidade[]  @relation("SolicitacaoUnidadeSolicitante")

  solicitacoesUnidadeDecididas SolicitacaoUnidade[]  @relation("SolicitacaoUnidadeDecisor")

  pedidoTicketsAtendente       SaasPedidoTicket[]    @relation("PedidoTicketAtendente")

  pedidoTicketsFechados        SaasPedidoTicket[]    @relation("PedidoTicketFechadoPor")

  brechoLojas                  BrechoLoja[]
  brechoLojasCongeladas         BrechoLoja[]          @relation("BrechoLojaCongeladaPor")
  brechoAnuncios               BrechoAnuncio[]       @relation("BrechoAnuncioVendedor")
  brechoInteresses             BrechoInteresse[]     @relation("BrechoInteresseInteressado")
  brechoTrocasVendedor         BrechoTroca[]          @relation("BrechoTrocaVendedor")
  brechoTrocasInteressado      BrechoTroca[]          @relation("BrechoTrocaInteressado")
  denunciasBrecho              DenunciaBrecho[]      @relation("DenunciaBrechoDenunciante")
  denunciasBrechoResolvidas    DenunciaBrecho[]      @relation("DenunciaBrechoResolvidoPor")
  denunciasBrechoAtendidas     DenunciaBrecho[]      @relation("DenunciaBrechoAtendente")

  artigosPortal                 ArtigoPortal[]

  forumTopicos                  ForumTopico[]

  forumRespostas                ForumResposta[]

  pracaVotos                    PracaVoto[]

  pracaComentarios              PracaComentario[]

  forumScoreEventos            ForumScoreEvento[]

  forumScoreSaldos              ForumScoreSaldo[]

  confiancaEventos             ConfiancaEvento[]

  confiancaSaldos              ConfiancaSaldo[]

  membrosFonteVerificada        SaasMembro[]          @relation("FonteVerificadaPor")


  // Controle de acesso lista pessoas por vínculo com a torcida ordenando por
  // nome/e-mail: com o índice, a página vira varredura ordenada com LIMIT em vez
  // de ordenar o resultado inteiro do semi-join.
  @@index([nome])

  @@map("saas_users")

}



// ─── CARGOS E PERMISSÕES ─────────────────────────────────────────────────────



model Role {

  id          String   @id @default(uuid())

  tenantId    String   @map("tenant_id")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nome        String

  cor         String   @default("#6b7280")

  ordem       Int      @default(0)

  isSystem    Boolean  @default(false) @map("is_system")

  /// Pacote legado / transversal (sem departamento). Perfis de área preferem

  /// herança ao vivo do Departamento + permissionsExtras.

  permissions String[] @default([])

  /// Deltas além do pacote do departamento (Presidente, perfis compostos…).

  permissionsExtras String[] @default([]) @map("permissions_extras")

  /// Área de atuação — null = perfil transversal (ex.: member).

  departamentoId String? @map("departamento_id")

  departamento   Departamento? @relation(fields: [departamentoId], references: [id], onDelete: SetNull)

  /// MEMBRO | GESTOR — obrigatório quando departamentoId está setado.

  papelNoDepartamento String? @map("papel_no_departamento")



  userRoles UserRole[]



  @@unique([tenantId, nome])

  @@index([departamentoId])

  @@map("saas_roles")

}



model UserRole {

  id       String @id @default(uuid())

  userId   String @map("user_id")

  tenantId String @map("tenant_id")

  roleId   String @map("role_id")



  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)



  criadoEm DateTime @default(now()) @map("criado_em")



  @@unique([userId, tenantId, roleId])

  @@index([tenantId])

  @@map("saas_user_roles")

}



model UserPermission {

  id         String  @id @default(uuid())

  userId     String  @map("user_id")

  tenantId   String  @map("tenant_id")

  permission String

  granted    Boolean



  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)



  criadoEm DateTime @default(now()) @map("criado_em")



  @@unique([userId, tenantId, permission])

  @@index([tenantId])

  @@map("saas_user_permissions")

}



// ─── DEPARTAMENTOS ────────────────────────────────────────────────────────────

// Agrupamento organizacional (Diretoria, Financeiro, Comunicação…).

// Perfis (Role) de área vinculam-se ao departamento (membro/gestor) e herdam

// o pacote ao vivo; Role.permissionsExtras guarda deltas. UserDepartamento /

// DepartamentoGestor são projeção ao atribuir o perfil.

// Sócio/Torcedor NÃO são departamentos. Lista plana por tenant (MVP).



model Departamento {

  id       String @id @default(uuid())

  tenantId String @map("tenant_id")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)



  nome         String

  slug         String   @default("")

  moduloPortal String?  @map("modulo_portal")

  /// Permissões do membro da equipe (ver / agir leve).

  permissions  String[] @default([])

  /// Permissões adicionais do gestor (gerir a área). Composição:

  /// membro → permissions; gestor → permissions ∪ permissionsGestor.

  permissionsGestor String[] @default([]) @map("permissions_gestor")

  cor          String   @default("#6b7280")

  ordem        Int      @default(0)

  /// Canal (Conversa tipo CANAL) oficial da área — provisionado automaticamente
  /// (`ensureCanalDepartamento`) e aberto só à equipe + gestores.

  canalConversaId String? @unique @map("canal_conversa_id")

  canalConversa   Conversa? @relation("DepartamentoCanal", fields: [canalConversaId], references: [id], onDelete: SetNull)

  /// Meta de área (ex.: checklist barracão do Carnaval). Não é RBAC.

  meta         Json?

  criadoEm     DateTime @default(now()) @map("criado_em")



  membros  UserDepartamento[]

  gestores DepartamentoGestor[]

  areas    DepartamentoArea[]

  projetos Projeto[]

  lancamentos FinanceiroLancamento[] @relation("FinanceiroLancamentoDepartamento")

  roles    Role[]

  /// Preferência de área no cadastro (SaasMembro) — sem membership até APROVADO.

  solicitacoesMembros SaasMembro[] @relation("MembroDepartamentoPreferido")

  /// Preferência de área na SEDE declarada por quem entrou por uma unidade.

  solicitacoesSede    SaasMembro[] @relation("MembroDepartamentoSede")



  @@unique([tenantId, nome])

  @@unique([tenantId, slug])

  @@map("saas_departamentos")

}



/// Associação usuário ↔ departamento (multi-departamento, como cargos do Discord)

model UserDepartamento {

  id             String @id @default(uuid())

  userId         String @map("user_id")

  tenantId       String @map("tenant_id")

  departamentoId String @map("departamento_id")



  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  departamento Departamento @relation(fields: [departamentoId], references: [id], onDelete: Cascade)



  criadoEm DateTime @default(now()) @map("criado_em")



  @@unique([userId, tenantId, departamentoId])

  @@index([departamentoId])

  // O unique começa por userId, então "quem é desta torcida" não o aproveitava.
  @@index([tenantId])

  @@map("saas_user_departamentos")

}



/// Quem pode gerenciar os membros de um departamento (adicionar/remover membros,

/// atribuir perfis dentro do escopo do departamento). Owners/admins do tenant

/// (via Role.isSystem) continuam com acesso total independente desta tabela —

/// isso serve para delegar gestão de UM departamento específico a alguém que

/// não é admin geral (ex: liderança de um departamento na subsede/pde).

model DepartamentoGestor {

  id             String @id @default(uuid())

  departamentoId String @map("departamento_id")

  userId         String @map("user_id")



  departamento Departamento @relation(fields: [departamentoId], references: [id], onDelete: Cascade)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)



  criadoEm DateTime @default(now()) @map("criado_em")



  @@unique([departamentoId, userId])

  @@index([userId])

  @@map("saas_departamento_gestores")

}



/// Área interna de um departamento (ex.: Campanha do Agasalho dentro do Social).
/// Organiza gente e trabalho — NÃO concede permissão. RBAC continua no
/// Departamento (permissions/permissionsGestor); área é só rótulo e filtro.
model DepartamentoArea {

  id             String @id @default(cuid())

  tenantId       String @map("tenant_id")

  departamentoId String @map("departamento_id")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  departamento Departamento @relation(fields: [departamentoId], references: [id], onDelete: Cascade)



  nome      String

  slug      String

  /// O que a área faz na prática — a riqueza de conhecimento do produto.
  descricao String?

  /// Chave de ícone (string, nunca componente React).
  icone     String?

  ordem     Int     @default(0)

  ativa     Boolean @default(true)

  /// Agasalho/Natal: ativa em janela específica do ano.
  sazonal   Boolean @default(false)

  /// Checklist/config leve da área (mesmo padrão de Departamento.meta). Não é RBAC.
  meta      Json?

  /// Canal (Conversa tipo CANAL) da frente — provisionado automaticamente
  /// (`ensureCanalArea`). Unique: uma conversa não serve a duas áreas nem a
  /// sede/depto ao mesmo tempo (checagem na action + unique no ponteiro).
  canalConversaId String? @unique @map("canal_conversa_id")

  canalConversa   Conversa? @relation("DepartamentoAreaCanal", fields: [canalConversaId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now()) @map("criado_em")

  atualizadoEm DateTime @updatedAt @map("atualizado_em")



  membros  DepartamentoAreaMembro[]

  projetos Projeto[]

  patrimonioItens PatrimonioItem[]

  @@unique([departamentoId, slug])

  @@index([tenantId, ativa])

  @@map("saas_departamento_areas")

}



/// Associação usuário ↔ área de departamento. Exige `UserDepartamento` prévio
/// no departamento pai (elegibilidade validada na Server Action, não aqui).
/// `papel = RESPONSAVEL` é accountability, não gestão — quem gere é
/// `DepartamentoGestor` / `canManageDepartamento`.
model DepartamentoAreaMembro {

  id     String @id @default(cuid())

  areaId String @map("area_id")

  userId String @map("user_id")

  area DepartamentoArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)



  /// MEMBRO | RESPONSAVEL — rótulo, nunca permissão.
  papel PapelAreaDepartamento @default(MEMBRO)

  criadoEm DateTime @default(now()) @map("criado_em")



  @@unique([areaId, userId])

  @@index([userId])

  @@map("saas_departamento_area_membros")

}

enum PapelAreaDepartamento {

  MEMBRO

  RESPONSAVEL

}



/// Trabalho de um departamento com começo, meta e prestação de contas
/// (Campanha do Agasalho, Festa das Crianças, Escolinha da Bateria, Corrida de
/// Rua). Transversal: serve Social, Bateria, Carnaval, Caravanas e Patrimônio.
/// Como a área, NÃO concede permissão — quem gere é `canManageDepartamento`.
model Projeto {

  id             String @id @default(cuid())

  tenantId       String @map("tenant_id")

  departamentoId String @map("departamento_id")

  /// Frente dentro do departamento. Nulo = projeto do departamento inteiro.
  areaId         String? @map("area_id")

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  departamento Departamento      @relation(fields: [departamentoId], references: [id], onDelete: Cascade)

  area         DepartamentoArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)



  titulo    String

  slug      String

  descricao String?

  tipo      TipoProjeto   @default(PROJETO)

  status    StatusProjeto @default(PLANEJADO)



  /// Janela de execução. `fim` nulo = contínuo (ex.: Inclusão Digital).
  inicio DateTime

  fim    DateTime?

  /// Tradição que se repete todo ano (Agasalho, Natal) — usado no resumo.
  recorrenteAnual Boolean @default(false)



  /// Meta de alcance, com a unidade em texto ("pessoas atendidas", "peças").
  metaQuantidade Int?     @map("meta_quantidade")

  metaUnidade    String?  @map("meta_unidade")

  /// Quanto já foi alcançado — atualizado à mão por quem gere.
  realizadoQuantidade Int @default(0) @map("realizado_quantidade")

  /// Orçamento previsto; o realizado vem da soma dos lançamentos vinculados.
  orcamentoPrevisto Decimal? @map("orcamento_previsto") @db.Decimal(12, 2)



  /// Quem responde pelo projeto — accountability, nunca permissão.
  responsavelId String? @map("responsavel_id")

  responsavel   User?   @relation("ProjetoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)

  criadoPorId   String  @map("criado_por_id")

  criadoEm      DateTime @default(now()) @map("criado_em")

  atualizadoEm  DateTime @updatedAt @map("atualizado_em")



  participantes ProjetoParticipante[]

  lancamentos   FinanceiroLancamento[]

  eventos       Evento[]



  @@unique([departamentoId, slug])

  @@index([tenantId, status, inicio])

  @@index([tenantId, departamentoId])

  @@index([areaId])

  @@map("saas_projetos")

}



/// Voluntário/equipe de um projeto. Subconjunto de quem já está no
/// departamento — validado na Server Action, como na área.
model ProjetoParticipante {

  id        String @id @default(cuid())

  projetoId String @map("projeto_id")

  userId    String @map("user_id")

  projeto Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)



  criadoEm DateTime @default(now()) @map("criado_em")



  @@unique([projetoId, userId])

  @@index([userId])

  @@map("saas_projeto_participantes")

}



enum TipoProjeto {

  /// Arrecadação sazonal com meta (Agasalho, Natal, Páscoa).
  CAMPANHA

  /// Trabalho contínuo (Inclusão Digital, Escolinha da Bateria).
  PROJETO

  /// Ação pontual (Doação de Sangue, Dia da Saúde).
  ACAO

  /// Convênio com universidade/instituição.
  PARCERIA

}



enum StatusProjeto {

  PLANEJADO

  ATIVO

  CONCLUIDO

  CANCELADO

}



// ─── MEMBROS SaaS ─────────────────────────────────────────────────────────────



model SaasMembro {

  id       String @id @default(uuid())

  tenantId String @map("tenant_id")

  userId   String @map("user_id")



  tipo            TipoMembro

  nome            String

  idade           Int?

  telefone        String?

  cidade          String?

  numeroAssociado String?      @map("numero_associado")

  anosSocio       Int?         @map("anos_socio")

  cep             String?      @map("cep")

  numero          String?      @map("numero")

  bloco           String?      @map("bloco")

  complemento     String?      @map("complemento")

  imagemProva     String?      @map("imagem_prova")

  status          StatusMembro @default(PENDENTE)



  // Campos LGE (Lei 14.597/2023) — sensíveis; nunca em perfil público.

  rg             String?

  /// Somente dígitos; único por tenant quando preenchido.

  cpf            String?

  filiacao       String?

  escolaridade   String?

  profissao      String?

  dataNascimento DateTime? @map("data_nascimento")

  sexo                          String?
  estadoCivil                   String?   @map("estado_civil")
  nacionalidade                 String?
  logradouro                    String?
  bairro                        String?
  uf                            String?   @db.Char(2)
  fotoDocumentoUrl              String?   @map("foto_documento_url")
  comprovanteResidenciaUrl      String?   @map("comprovante_residencia_url")
  responsavelNome               String?   @map("responsavel_nome")
  responsavelDocumento          String?   @map("responsavel_documento")
  autorizacaoMenorAceitaEm      DateTime? @map("autorizacao_menor_aceita_em")
  termoResponsabilidadeAceitoEm DateTime? @map("termo_responsabilidade_aceito_em")



  /// Plano de associação da torcida (não confundir com Tenant.plano SaaS).

  planoAssociacaoId String?           @map("plano_associacao_id")

  planoAssociacao   PlanoAssociacao?  @relation(fields: [planoAssociacaoId], references: [id], onDelete: SetNull)

  /// Data de expedição da carteirinha física — onboarding «Já sou sócio».
  dataExpedicaoCarteirinha DateTime? @map("data_expedicao_carteirinha")

  /// Periodicidade pretendida no onboarding (quando ainda não há PlanoAssociacao).
  periodicidadePretendida PeriodicidadePlanoAssociacao? @map("periodicidade_pretendida")

  /// Espelho operacional: false se há cobrança vencida/pendente relevante
  /// **ou** pendência de cadastro dispensada sem completar (ver
  /// `pendenciasCadastroDispensadas` + `lib/pendencias-cadastro.ts`).

  adimplente Boolean @default(true)

  /// Códigos de `PENDENCIAS_CADASTRO_CODIGOS` que o sócio marcou
  /// «não mostrar de novo». Esconde o modal; a pendência em si só some
  /// quando os dados faltantes forem preenchidos.

  pendenciasCadastroDispensadas String[] @default([]) @map("pendencias_cadastro_dispensadas")



  aprovadoPorId   String?   @map("aprovado_por_id")

  aprovadoPorNome String?   @map("aprovado_por_nome")

  aprovadoEm      DateTime? @map("aprovado_em")



  // Reprovação da solicitação (MEMBERS_REJECT). A justificativa é obrigatória
  // na Server Action; `reprovadoPontos` guarda ids do catálogo
  // PONTOS_REPROVACAO (@torcida/types) para o card de detalhes destacar em
  // vermelho exatamente a etapa/campo recusado. Limpo ao aprovar/reverter.

  reprovadoEm     DateTime? @map("reprovado_em")

  reprovadoPorId   String?  @map("reprovado_por_id")

  reprovadoPorNome String?  @map("reprovado_por_nome")

  reprovadoCategoria String? @map("reprovado_categoria")

  reprovadoMotivo    String? @map("reprovado_motivo")

  reprovadoPontos    String[] @default([]) @map("reprovado_pontos")

  /// false = reprovação definitiva; o solicitante não pode reenviar o cadastro
  /// (só volta à fila se um admin reverter para PENDENTE).

  reprovadoPermiteReenvio Boolean @default(true) @map("reprovado_permite_reenvio")



  // Desligamento estatutário (MEMBERS_DISMISS) — distinto de bloqueio.

  desligadoEm     DateTime? @map("desligado_em")

  desligadoMotivo String?   @map("desligado_motivo")

  desligadoPorId  String?   @map("desligado_por_id")



  // Referência ao registro legado do bot (para migração gradual)

  discordId  String? @map("discord_id")

  discordTag String? @map("discord_tag")



  // Vínculo territorial principal — a qual Sede/Subsede/PDE específica do

  // tenant este associado pertence (um tenant pode ter várias linhas de

  // Sede, ex: vários pontos de encontro). Nullable para não quebrar

  // cadastros existentes e tenants com uma única Sede.

  sedeId String? @map("sede_id")

  sede   Sede?   @relation(fields: [sedeId], references: [id], onDelete: SetNull)



  /// Departamento pretendido no onboarding (sócio). NÃO cria UserDepartamento

  /// nem perfil de área enquanto status ≠ APROVADO — só após aprovarMembro.

  /// Sempre do MESMO tenant desta linha: numa origem em Subsede/PDE promovida

  /// é a área na unidade; no espelho da Sede, a área na Sede.

  departamentoId String?       @map("departamento_id")

  departamento   Departamento? @relation("MembroDepartamentoPreferido", fields: [departamentoId], references: [id], onDelete: SetNull)



  /// Só na linha de ORIGEM de um vínculo que nasceu em tenant-filho (Caso B):

  /// área pretendida na SEDE raiz, declarada no onboarding. Carrega a

  /// preferência até o espelho existir — `sincronizarSocioNaSedeRaiz` a copia

  /// para o `departamentoId` do espelho. Departamento é por tenant, então o

  /// sócio pode ser da Bateria nos dois níveis com papéis diferentes em cada.

  departamentoSedeId String?       @map("departamento_sede_id")

  departamentoSede   Departamento? @relation("MembroDepartamentoSede", fields: [departamentoSedeId], references: [id], onDelete: SetNull)



  // Rastro de origem: qual importação criou este membro (null = cadastro

  // orgânico). Permite auditar e desfazer importações (ex: dados MOCK de

  // demonstração) sem tocar em membros reais.

  importacaoId String?            @map("importacao_id")

  importacao   ImportacaoMembros? @relation(fields: [importacaoId], references: [id], onDelete: SetNull)



  /// true = esta linha é um ESPELHO gerado a partir de outra unidade da

  /// mesma torcida (Caso B). false = linha orgânica. Em PENDENTE, a Sede

  /// pode aprovar/recusar (exceção pontual à R1 — fila compartilhada /

  /// first-wins). Demais mutações (LGE, desligar, sede, carteirinha) só

  /// na origem.

  espelhado Boolean @default(false) @map("espelhado")



  /// Só no espelho: tenantId da Subsede/PDE de origem do vínculo

  /// (unidade onde o sócio solicitou ingresso).

  aprovadoNaUnidadeTenantId String? @map("aprovado_na_unidade_tenant_id")



  /// Ponteiro 1:1 para a linha de ORIGEM (na Subsede/PDE) que este espelho

  /// reflete. SetNull (não Cascade): se o tenant-filho for excluído, o

  /// espelho vira histórico órfão em vez de sumir (LGE: sem exclusão física).

  membroOrigemId String?     @unique @map("membro_origem_id")

  membroOrigem   SaasMembro? @relation("MembroEspelho", fields: [membroOrigemId], references: [id], onDelete: SetNull)

  membroEspelho  SaasMembro? @relation("MembroEspelho")



  criadoEm     DateTime @default(now()) @map("criado_em")

  atualizadoEm DateTime @updatedAt @map("atualizado_em")



  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  user      User                 @relation(fields: [userId], references: [id])

  cobrancas CobrancaAssociacao[]

  barFiados BarFiado[]

  barComandas BarComanda[]

  fonteVerificadaEm     DateTime? @map("fonte_verificada_em")

  fonteVerificadaPorId String?   @map("fonte_verificada_por_id")

  fonteVerificadaPor    User?     @relation("FonteVerificadaPor", fields: [fonteVerificadaPorId], references: [id], onDelete: SetNull)



  @@unique([tenantId, userId])

  @@unique([tenantId, cpf])

  @@index([sedeId])

  @@index([departamentoId])

  @@index([departamentoSedeId])

  @@index([importacaoId])

  // A listagem do admin sempre parte de tenantId + aba de situação e ordena por
  // data de cadastro ou nome; sem o sufixo de ordenação o Postgres precisa
  // ordenar a fatia inteira antes de aplicar o LIMIT da paginação.
  @@index([tenantId, status, criadoEm])

  @@index([tenantId, criadoEm])

  @@index([tenantId, nome])

  @@index([tenantId, adimplente])

  @@index([planoAssociacaoId])

  @@index([espelhado])

  @@map("saas_membros")

}



enum TipoMembro {

  SOCIO

  TORCEDOR

}



enum StatusMembro {

  PENDENTE

  APROVADO

  REPROVADO

}



// ─── IMPORTAÇÃO DE MEMBROS ───────────────────────────────────────────────────

// Staging + auditoria de cada execução de importação da base de associados.

// Ver docs/data/spec-importacao-membros.md. Origem MOCK = dados de demonstração,

// rastreáveis via SaasMembro.importacaoId e reversíveis (desfazerImportacao).



model ImportacaoMembros {

  id          String           @id @default(uuid())

  tenantId    String           @map("tenant_id")

  origem      OrigemImportacao

  status      StatusImportacao @default(PENDENTE)

  totalLinhas Int              @default(0) @map("total_linhas")

  importados  Int              @default(0)

  duplicados  Int              @default(0)

  erros       Json?

  criadoPorId String?          @map("criado_por_id")

  criadoEm    DateTime         @default(now()) @map("criado_em")



  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  membros SaasMembro[]



  @@index([tenantId, criadoEm])

  @@map("saas_importacoes_membros")

}



enum OrigemImportacao {

  CSV

  BOT

  DISCORD

  MOCK

}



enum StatusImportacao {

  PENDENTE

  PROCESSANDO

  CONCLUIDA

  ERRO

}



// ─── SÓCIOS / CARTEIRINHAS ───────────────────────────────────────────────────



model SaasSocio {

  id          String   @id @default(uuid())

  tenantId    String   @map("tenant_id")

  userId      String   @map("user_id")

  numeroSocio Int      @map("numero_socio")

  nome        String

  validade    DateTime

  /// Data de expedição usada no cálculo da validade (onboarding ou emissão).
  expedidoEm  DateTime? @map("expedido_em")

  criadoEm    DateTime @default(now()) @map("criado_em")

  discordId   String?  @map("discord_id")

  /// Segredo opaco para QR verificável (HMAC com AUTH_SECRET).

  qrToken     String?  @unique @map("qr_token")

  qrEmitidoEm DateTime? @map("qr_emitido_em")



  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  user   User   @relation(fields: [userId], references: [id])



  @@unique([tenantId, numeroSocio])

  @@unique([tenantId, userId])

  // Abas Ativos/Vencendo/Vencidos filtram por validade; sem o índice a
  // paginação ordena a torcida inteira antes do LIMIT.
  @@index([tenantId, validade])

  @@index([tenantId, nome])

  @@map("saas_socios")

}



// ─── PLANOS DE ASSOCIAÇÃO + COBRANÇAS (não confundir com Tenant.plano SaaS) ───

// Ver docs/product/plano-paridade-concorrentes.md Fase A.



model PlanoAssociacao {

  id            String                     @id @default(uuid())

  tenantId      String                     @map("tenant_id")

  nome          String

  descricao     String?

  /// Valor da contribuição periódica (sempre positivo).

  valor         Decimal                    @db.Decimal(12, 2)

  periodicidade PeriodicidadePlanoAssociacao @default(MENSAL)

  beneficios    String?

  ativo         Boolean                    @default(true)

  criadoEm      DateTime                   @default(now()) @map("criado_em")

  atualizadoEm  DateTime                   @updatedAt @map("atualizado_em")



  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  membros   SaasMembro[]

  cobrancas CobrancaAssociacao[]



  @@index([tenantId, ativo])

  @@map("saas_planos_associacao")

}



enum PeriodicidadePlanoAssociacao {

  MENSAL

  TRIMESTRAL

  QUADRIMENSAL

  SEMESTRAL

  ANUAL

  UNICA

}



model CobrancaAssociacao {

  id       String @id @default(uuid())

  tenantId String @map("tenant_id")

  userId   String @map("user_id")

  membroId String? @map("membro_id")



  planoAssociacaoId String? @map("plano_associacao_id")

  /// Vaga de caravana / cobrança vinculada a evento (paridade C1).

  eventoId          String? @map("evento_id")

  tipo              TipoCobrancaAssociacao

  descricao         String

  valor             Decimal @db.Decimal(12, 2)

  vencimento        DateTime

  status            StatusCobrancaAssociacao @default(PENDENTE)

  pagoEm            DateTime? @map("pago_em")

  metodoPagamento   MetodoPagamentoCobranca? @map("metodo_pagamento")



  pixCopiaCola      String? @map("pix_copia_cola")

  gatewayProvider   String? @map("gateway_provider")

  gatewayExternalId String? @map("gateway_external_id")



  financeiroLancamentoId String? @unique @map("financeiro_lancamento_id")



  criadoPorId  String?  @map("criado_por_id")

  criadoEm     DateTime @default(now()) @map("criado_em")

  atualizadoEm DateTime @updatedAt @map("atualizado_em")



  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  membro          SaasMembro?      @relation(fields: [membroId], references: [id], onDelete: SetNull)

  planoAssociacao PlanoAssociacao? @relation(fields: [planoAssociacaoId], references: [id], onDelete: SetNull)

  evento          Evento?          @relation(fields: [eventoId], references: [id], onDelete: SetNull)

  criadoPor       User?            @relation("CobrancaAssociacaoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)



  @@index([tenantId, status, vencimento])

  @@index([tenantId, userId])

  @@index([membroId])

  @@index([eventoId])

