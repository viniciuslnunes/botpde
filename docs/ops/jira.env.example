# Jira / Atlassian CLI — variáveis locais (exemplo)

# Copie para a raiz do monorepo:
#   cp docs/ops/jira.env.example .env.jira
# `.env.jira` é gitignored (padrão `.env.*`). Nunca commit token.

# Host do site Jira Cloud (sem https://)
JIRA_SITE=setorize-torcidas.atlassian.net

# Chave do projeto padrão (pnpm jira:create) — types PT: Tarefa, História, Bug, Epic
JIRA_PROJECT=KAN

# E-mail da conta Atlassian (auth por token)
JIRA_EMAIL=voce@empresa.com

# NÃO coloque ATLASSIAN_API_TOKEN neste arquivo se for compartilhá-lo.
# Preferência: pnpm jira:auth  (OAuth no browser)
# Alternativa: echo "$ATLASSIAN_API_TOKEN" | pnpm jira:auth -- --token

# Bitbucket (só para `pnpm sync:bitbucket` — fetch HTTPS)
# Crie em https://id.atlassian.com/manage-profile/security/api-tokens
# com scopes Bitbucket: read:repository:bitbucket (e write se for push).
# BITBUCKET_API_TOKEN=
