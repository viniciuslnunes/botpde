// ─── TABELAS ───────────────────────────────────────────────────────────────

Table membros {
  id integer [pk, increment]
  discord_id varchar [unique, not null]
  nome varchar [not null]
  tipo varchar [not null, note: '\'socio\' ou \'torcedor\'']
  numero_associado varchar
  cidade varchar
  telefone varchar
  idade integer
  aprovado_por_id varchar
  aprovado_por_nome varchar
  criado_em timestamp
  imagem_prova varchar
  Note: 'Tabela legada do bot — lida pelo SaaS para exibir dados no portal'
}

Table BotProduto {
  id integer [pk, increment]
  nome varchar [not null]
  tamanhos varchar [not null]
  preco decimal(10, 2) [not null]
  imagem_url varchar
  ativo boolean
  criado_em timestamp
  estoque json
  Note: 'Tabela legada do bot — produtos da loja'
}

Table pedidos {
  id integer [pk, increment]
  discord_id varchar [not null]
  discord_tag varchar
  produto_id integer
  produto_nome varchar
  tamanho varchar
  quantidade integer [not null]
  preco_unit decimal(10, 2)
  total decimal(10, 2)
  status varchar
  canal_ticket_id varchar
  criado_em timestamp
  Note: 'Tabela legada do bot — pedidos da loja'
}

Table aprovacoes_recrutamento {
  id integer [pk, increment]
  aprovador_id varchar [not null]
  aprovador_nome varchar
  candidato_id varchar
  candidato_nome varchar
  tipo varchar
  criado_em timestamp
  Note: 'Tabela legada do bot — ranking de recrutadores'
}

Table bot_config {
  key varchar [pk]
  value varchar
  Note: 'Tabela legada do bot — configurações persistidas (IDs de mensagens)'
}

Table saas_tenants {
  id varchar [pk]
  slug varchar [unique, not null]
  nome varchar [not null]
  plano Plano [not null]
  cor_primaria varchar [not null]
  logo_url varchar
  design json
  ativo boolean [not null]
  criado_em timestamp [not null]
  hierarquia_visivel_para_filhos boolean [not null]
  loja_visivel_nas_unidades boolean [not null]
  agenda_visivel_nas_unidades boolean [not null]
  sintetico boolean [not null]
  database_url varchar
  discord_guild_id varchar [unique]
  afiliacao_id varchar
  torcida_conhecida_id varchar [unique]
  canal_restrito boolean [not null]
  canal_restrito_desde timestamp
  canal_restrito_por_id varchar
  convite_slug varchar [unique]
  convite_ativo boolean [not null]
  balanco_financeiro_visivel boolean [not null]
  balanco_detalhe_nivel BalancoDetalheNivel [not null]
  exigir_documentos_cadastro boolean [not null]
  solicitar_pendencias_cadastro boolean [not null]
  propagar_pendencias_cadastro_unidades boolean [not null]
  periodicidades_onboarding PeriodicidadePlanoAssociacao[]
  suporte_plataforma boolean [not null]
  suporte_plataforma_desde timestamp
  suporte_plataforma_por_id varchar
}

Table saas_users {
  id varchar [pk]
  email varchar [unique]
  nome varchar
  nickname varchar [unique]
  avatar_url varchar
  criado_em timestamp [not null]
  discord_id varchar [unique]
  google_id varchar [unique]
  senha_hash varchar
  consentido_em timestamp
  ultimo_acesso_em timestamp
  Indexes {
    nome [name: 'idx']
  }
}

Table saas_roles {
  id varchar [pk]
  tenant_id varchar [not null]
  nome varchar [not null]
  cor varchar [not null]
  ordem integer [not null]
  is_system boolean [not null]
  permissions varchar[]
  permissions_extras varchar[]
  departamento_id varchar
  papel_no_departamento varchar
  Indexes {
    (tenant_id, nome) [unique]
    departamento_id [name: 'idx']
  }
}

Table saas_user_roles {
  id varchar [pk]
  user_id varchar [not null]
  tenant_id varchar [not null]
  role_id varchar [not null]
  criado_em timestamp [not null]
  Indexes {
    (user_id, tenant_id, role_id) [unique]
    tenant_id [name: 'idx']
  }
}

Table saas_user_permissions {
  id varchar [pk]
  user_id varchar [not null]
  tenant_id varchar [not null]
  permission varchar [not null]
  granted boolean [not null]
  criado_em timestamp [not null]
  Indexes {
    (user_id, tenant_id, permission) [unique]
    tenant_id [name: 'idx']
  }
}

Table saas_departamentos {
  id varchar [pk]
  tenant_id varchar [not null]
  nome varchar [not null]
  slug varchar [not null]
  modulo_portal varchar
  permissions varchar[]
  permissions_gestor varchar[]
  cor varchar [not null]
  ordem integer [not null]
  canal_conversa_id varchar [unique]
  meta json
  criado_em timestamp [not null]
  Indexes {
    (tenant_id, nome) [unique]
    (tenant_id, slug) [unique]
  }
}

Table saas_user_departamentos {
  id varchar [pk]
  user_id varchar [not null]
  tenant_id varchar [not null]
  departamento_id varchar [not null]
  criado_em timestamp [not null]
  Indexes {
    (user_id, tenant_id, departamento_id) [unique]
    departamento_id [name: 'idx']
    tenant_id [name: 'idx']
  }
  Note: 'Associação usuário ↔ departamento (multi-departamento, como cargos do Discord)'
}

Table saas_departamento_gestores {
  id varchar [pk]
  departamento_id varchar [not null]
  user_id varchar [not null]
  criado_em timestamp [not null]
  Indexes {
    (departamento_id, user_id) [unique]
    user_id [name: 'idx']
  }
  Note: 'Quem pode gerenciar os membros de um departamento (adicionar/remover membros, atribuir perfis dentro do escopo do departamento). Owners/admins do tenant (via Role.isSystem) continuam com acesso total independente desta tabela — isso serve para delegar gestão de UM departamento específico a alguém que não é admin geral (ex: liderança de um departamento na subsede/pde).'
}

Table saas_departamento_areas {
  id varchar [pk]
  tenant_id varchar [not null]
  departamento_id varchar [not null]
  nome varchar [not null]
  slug varchar [not null]
  descricao varchar
  icone varchar
  ordem integer [not null]
  ativa boolean [not null]
  sazonal boolean [not null]
  meta json
  canal_conversa_id varchar [unique]
  criado_em timestamp [not null]
  atualizado_em timestamp [not null]
  Indexes {
    (departamento_id, slug) [unique]
    (tenant_id, ativa) [name: 'idx']
  }
  Note: 'Área interna de um departamento (ex.: Campanha do Agasalho dentro do Social). Organiza gente e trabalho — NÃO concede permissão. RBAC continua no Departamento (permissions/permissionsGestor); área é só rótulo e filtro.'
}

Table saas_departamento_area_membros {
  id varchar [pk]
  area_id varchar [not null]
  user_id varchar [not null]
  papel PapelAreaDepartamento [not null]
  criado_em timestamp [not null]
  Indexes {
    (area_id, user_id) [unique]
    user_id [name: 'idx']
  }
  Note: 'Associação usuário ↔ área de departamento. Exige `UserDepartamento` prévio no departamento pai (elegibilidade validada na Server Action, não aqui). `papel = RESPONSAVEL` é accountability, não gestão — quem gere é `DepartamentoGestor` / `canManageDepartamento`.'
}

Table saas_projetos {
  id varchar [pk]
  tenant_id varchar [not null]
  departamento_id varchar [not null]
  area_id varchar
  titulo varchar [not null]
  slug varchar [not null]
  descricao varchar
  tipo TipoProjeto [not null]
  status StatusProjeto [not null]
  inicio timestamp [not null]
  fim timestamp
  recorrenteAnual boolean [not null]
  meta_quantidade integer
  meta_unidade varchar
  realizado_quantidade integer [not null]
  orcamento_previsto decimal(12, 2)
  responsavel_id varchar
  criado_por_id varchar [not null]
  criado_em timestamp [not null]
  atualizado_em timestamp [not null]
  Indexes {
    (departamento_id, slug) [unique]
    (tenant_id, status, inicio) [name: 'idx']
    (tenant_id, departamento_id) [name: 'idx']
    area_id [name: 'idx']
  }
  Note: 'Trabalho de um departamento com começo, meta e prestação de contas (Campanha do Agasalho, Festa das Crianças, Escolinha da Bateria, Corrida de Rua). Transversal: serve Social, Bateria, Carnaval, Caravanas e Patrimônio. Como a área, NÃO concede permissão — quem gere é `canManageDepartamento`.'
}

Table saas_projeto_participantes {
  id varchar [pk]
  projeto_id varchar [not null]
  user_id varchar [not null]
  criado_em timestamp [not null]
  Indexes {
    (projeto_id, user_id) [unique]
    user_id [name: 'idx']
  }
  Note: 'Voluntário/equipe de um projeto. Subconjunto de quem já está no departamento — validado na Server Action, como na área.'
}

Table saas_membros {
  id varchar [pk]
  tenant_id varchar [not null]
  user_id varchar [not null]
  tipo TipoMembro [not null]
  nome varchar [not null]
  idade integer
  telefone varchar
  cidade varchar
  numero_associado varchar
  anos_socio integer
  cep varchar
  numero varchar
  bloco varchar
  complemento varchar
  imagem_prova varchar
  status StatusMembro [not null]
  rg varchar
  cpf varchar
  filiacao varchar
  escolaridade varchar
  profissao varchar
  data_nascimento timestamp
  sexo varchar
  estado_civil varchar
  nacionalidade varchar
  logradouro varchar
  bairro varchar
  uf char(2)
  foto_documento_url varchar
  comprovante_residencia_url varchar
  responsavel_nome varchar
  responsavel_documento varchar
  autorizacao_menor_aceita_em timestamp
  termo_responsabilidade_aceito_em timestamp
  plano_associacao_id varchar
  data_expedicao_carteirinha timestamp
  periodicidade_pretendida PeriodicidadePlanoAssociacao
  adimplente boolean [not null]
  pendencias_cadastro_dispensadas varchar[]
  aprovado_por_id varchar
  aprovado_por_nome varchar
  aprovado_em timestamp
  reprovado_em timestamp
  reprovado_por_id varchar
  reprovado_por_nome varchar
  reprovado_categoria varchar
  reprovado_motivo varchar
  reprovado_pontos varchar[]
  reprovado_permite_reenvio boolean [not null]
  desligado_em timestamp
  desligado_motivo varchar
  desligado_por_id varchar
  discord_id varchar
  discord_tag varchar
  sede_id varchar
  departamento_id varchar
  departamento_sede_id varchar
  importacao_id varchar
  espelhado boolean [not null]
  aprovado_na_unidade_tenant_id varchar
  membro_origem_id varchar [unique]
  criado_em timestamp [not null]
  atualizado_em timestamp [not null]
  Indexes {
    (tenant_id, user_id) [unique]
    (tenant_id, cpf) [unique]
    sede_id [name: 'idx']
    departamento_id [name: 'idx']
    departamento_sede_id [name: 'idx']
    importacao_id [name: 'idx']
    (tenant_id, status, criado_em) [name: 'idx']
    (tenant_id, criado_em) [name: 'idx']
    (tenant_id, nome) [name: 'idx']
    (tenant_id, adimplente) [name: 'idx']
    plano_associacao_id [name: 'idx']
    espelhado [name: 'idx']
  }
}

Table saas_importacoes_membros {
  id varchar [pk]
  tenant_id varchar [not null]
  origem OrigemImportacao [not null]
  status StatusImportacao [not null]
  total_linhas integer [not null]
  importados integer [not null]
  duplicados integer [not null]
  erros json
  criado_por_id varchar
  criado_em timestamp [not null]
  Indexes {
    (tenant_id, criado_em) [name: 'idx']
  }
}

Table saas_socios {
  id varchar [pk]
  tenant_id varchar [not null]
  user_id varchar [not null]
  numero_socio integer [not null]
  nome varchar [not null]
  validade timestamp [not null]
  expedido_em timestamp
  criado_em timestamp [not null]
  discord_id varchar
  qr_token varchar [unique]
  qr_emitido_em timestamp
  Indexes {
    (tenant_id, numero_socio) [unique]
    (tenant_id, user_id) [unique]
    (tenant_id, validade) [name: 'idx']
    (tenant_id, nome) [name: 'idx']
  }
}

Table saas_planos_associacao {
  id varchar [pk]
  tenant_id varchar [not null]
  nome varchar [not null]
  descricao varchar
  valor decimal(12, 2) [not null]
  periodicidade PeriodicidadePlanoAssociacao [not null]
  beneficios varchar
  ativo boolean [not null]
  criado_em timestamp [not null]
  atualizado_em timestamp [not null]
  Indexes {
    (tenant_id, ativo) [name: 'idx']
  }
}

Table saas_cobrancas_associacao {
  id varchar [pk]
  tenant_id varchar [not null]
  user_id varchar [not null]
  membro_id varchar
