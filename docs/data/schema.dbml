  financeiro_lancamento_id varchar [unique]
  criado_por_id varchar
  criado_em timestamp [not null]
  atualizado_em timestamp [not null]
  Indexes {
    (tenant_id, status, vencimento) [name: 'idx']
    (tenant_id, user_id) [name: 'idx']
    membro_id [name: 'idx']
    evento_id [name: 'idx']
    gateway_external_id [name: 'idx']
    (evento_id, user_id) [unique]
  }
}

Table saas_bloqueados {
