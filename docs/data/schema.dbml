  prazo timestamp [not null]
  emitido_por_id varchar
  emitido_por_nome varchar
  resolvida boolean [not null]
  criado_em timestamp [not null]
  Indexes {
    tenant_id [name: 'idx']
  }
}

Table saas_audit_logs {
  id varchar [pk]
  tenant_id varchar [not null]
  ator_id varchar
  acao varchar [not null]
  entidade varchar
  entidade_id varchar
  detalhes json
  criado_em timestamp [not null]
  Indexes {
    (tenant_id, criado_em) [name: 'idx']
    criado_em [name: 'idx']
  }
}

Table saas_financeiro_lancamentos {
  id varchar [pk]
  tenant_id varchar [not null]
  tipo TipoFinanceiroLancamento [not null]
  categoria CategoriaFinanceiroLancamento [not null]
  valor decimal(12, 2) [not null]
  descricao varchar [not null]
  data timestamp [not null]
  observacao varchar
  departamento_id varchar
  projeto_id varchar
  criado_por_id varchar [not null]
  criado_em timestamp [not null]
  atualizado_em timestamp [not null]
  Indexes {
    (tenant_id, data) [name: 'idx']
    (tenant_id, tipo, data) [name: 'idx']
    (tenant_id, categoria) [name: 'idx']
    (tenant_id, departamento_id, data) [name: 'idx']
    projeto_id [name: 'idx']
  }
}

Table saas_patrimonio_itens {
  id varchar [pk]
  tenant_id varchar [not null]
  nome varchar [not null]
  categoria CategoriaPatrimonioItem [not null]
  status StatusPatrimonioItem [not null]
  quantidade integer [not null]
  localizacao varchar
  valor_estimado decimal(12, 2)
  observacao varchar
  meta json
  area_id varchar
  responsavel_id varchar
  criado_por_id varchar [not null]
  criado_em timestamp [not null]
  atualizado_em timestamp [not null]
  Indexes {
    (tenant_id, status) [name: 'idx']
    (tenant_id, categoria) [name: 'idx']
    (tenant_id, nome) [name: 'idx']
    area_id [name: 'idx']
  }
}

Table saas_patrimonio_emprestimos {
  id varchar [pk]
  tenant_id varchar [not null]
  item_id varchar [not null]
  user_id varchar [not null]
  status StatusPatrimonioEmprestimo [not null]
  foto_saida_url varchar [not null]
  foto_guarda_url varchar
  observacao varchar
  dano_reportado boolean [not null]
  dano_observacao varchar
  aberto_em timestamp [not null]
  devolvido_em timestamp
  Indexes {
    (tenant_id, status, aberto_em) [name: 'idx']
    (item_id, status) [name: 'idx']
    (user_id, status) [name: 'idx']
  }
  Note: 'Empréstimo com evidência fotográfica (saída + guarda na devolução). Colaborador conclui sozinho; gestor audita e pode marcar dano.'
}

Table saas_bar_categorias {
  id varchar [pk]
  tenant_id varchar [not null]
  sede_id varchar [not null]
  nome varchar [not null]
  slug varchar [not null]
  ordem integer [not null]
  ativo boolean [not null]
  criado_em timestamp [not null]
  atualizado_em timestamp [not null]
  Indexes {
    (tenant_id, sede_id, slug) [unique]
    (tenant_id, sede_id) [name: 'idx']
  }
}

Table saas_bar_produtos {
  id varchar [pk]
  tenant_id varchar [not null]
  sede_id varchar [not null]
  categoria_id varchar
  nome varchar [not null]
  descricao varchar
  preco decimal(10, 2) [not null]
  custo_medio decimal(10, 2) [not null]
  estoque integer [not null]
  estoque_minimo integer
  imagem_url varchar
  ativo boolean [not null]
  destaque boolean [not null]
  ordem integer [not null]
  criado_por_id varchar
  criado_em timestamp [not null]
  atualizado_em timestamp [not null]
  Indexes {
    (tenant_id, sede_id, ativo) [name: 'idx']
    categoria_id [name: 'idx']
  }
}

Table saas_bar_vendas {
  id varchar [pk]
  tenant_id varchar [not null]
  sede_id varchar [not null]
  comanda_id varchar
  turno_id varchar
  operador_id varchar [not null]
  subtotal decimal(10, 2) [not null]
  desconto decimal(10, 2) [not null]
  total decimal(10, 2) [not null]
  metodo_pagamento MetodoPagamentoBar
  status StatusVendaBar [not null]
  gateway_provider varchar
  gateway_external_id varchar
  pix_copia_cola varchar
  pago_em timestamp
  financeiro_lancamento_id varchar
  financeiro_estorno_lancamento_id varchar
  observacao varchar
  estornado_por_id varchar
  estornado_em timestamp
  motivo_estorno varchar
  criado_em timestamp [not null]
  Indexes {
    (tenant_id, sede_id, criado_em) [name: 'idx']
    (tenant_id, sede_id, status) [name: 'idx']
    comanda_id [name: 'idx']
    turno_id [name: 'idx']
    gateway_external_id [name: 'idx']
  }
}

Table saas_bar_venda_itens {
  id varchar [pk]
  venda_id varchar [not null]
  produto_id varchar
  produto_nome varchar [not null]
  quantidade integer [not null]
  preco_unit decimal(10, 2) [not null]
  custo_unit decimal(10, 2) [not null]
  total decimal(10, 2) [not null]
  Indexes {
    venda_id [name: 'idx']
    produto_id [name: 'idx']
  }
}

Table saas_bar_fornecedores {
  id varchar [pk]
  tenant_id varchar [not null]
  nome varchar [not null]
  contato varchar
  documento varchar
  observacao varchar
  ativo boolean [not null]
  criado_em timestamp [not null]
  Indexes {
    (tenant_id, ativo) [name: 'idx']
  }
}

Table saas_bar_estoque_mov {
  id varchar [pk]
  tenant_id varchar [not null]
  sede_id varchar [not null]
  produto_id varchar [not null]
  tipo TipoMovEstoqueBar [not null]
  quantidade integer [not null]
  custo_total decimal(10, 2)
  motivo varchar
  venda_id varchar
  fornecedor_id varchar
  financeiro_lancamento_id varchar
  operador_id varchar
  criado_em timestamp [not null]
  Indexes {
    (tenant_id, sede_id, produto_id, criado_em) [name: 'idx']
  }
}

Table saas_bar_caixa_turnos {
  id varchar [pk]
  tenant_id varchar [not null]
  sede_id varchar [not null]
  aberto_em timestamp [not null]
  fechado_em timestamp
  aberto_por_id varchar [not null]
  fechado_por_id varchar
  sangria decimal(10, 2) [not null]
  dinheiro_contado decimal(10, 2)
  observacao varchar
  dinheiro_esperado decimal(10, 2)
  diferenca decimal(10, 2)
  divergencia_alta boolean [not null]
  criado_em timestamp [not null]
  Indexes {
    (tenant_id, sede_id, fechado_em) [name: 'idx']
  }
  Note: 'Turno de caixa do bar por unidade (SEDE/SUBSEDE/PDE). No máximo um turno aberto por unidade (fechadoEm = null) — enforced na aplicação.'
}

Table saas_bar_comandas {
  id varchar [pk]
  tenant_id varchar [not null]
  sede_id varchar [not null]
  codigo varchar [not null]
  titular_user_id varchar
  titular_membro_id varchar
  titular_nome varchar [not null]
  tipo TipoTitularComandaBar [not null]
  status StatusComandaBar [not null]
  limite decimal(10, 2)
  total decimal(10, 2) [not null]
  total_pago decimal(10, 2) [not null]
  desconto decimal(10, 2) [not null]
  turno_abertura_id varchar
  turno_fechamento_id varchar
  aberta_em timestamp [not null]
  aberta_por_id varchar [not null]
  fechada_em timestamp
  fechada_por_id varchar
  vencimento timestamp
  pago_em timestamp
  cancelada_em timestamp
  motivo_cancelamento varchar
  observacao varchar
  criado_em timestamp [not null]
  Indexes {
    (tenant_id, sede_id, status) [name: 'idx']
    (tenant_id, sede_id, codigo) [name: 'idx']
    titular_user_id [name: 'idx']
    titular_membro_id [name: 'idx']
  }
  Note: 'Conta aberta do bar (comanda) — acumula lançamentos (BarVenda EM_COMANDA) e fecha com um ou mais pagamentos. Substitui o fluxo de Fiado. Ver docs/data/modulo-bar-comanda.md.'
}

Table saas_bar_comanda_pagamentos {
  id varchar [pk]
  comanda_id varchar [not null]
  metodo_pagamento MetodoPagamentoBar [not null]
  valor decimal(10, 2) [not null]
  recebido_em timestamp [not null]
  turno_id varchar
  operador_id varchar [not null]
  gateway_provider varchar
  gateway_external_id varchar
  pix_copia_cola varchar
  pago_em timestamp
  status StatusPagamentoComandaBar [not null]
  financeiro_lancamento_id varchar [unique]
  criado_em timestamp [not null]
  Indexes {
    comanda_id [name: 'idx']
    turno_id [name: 'idx']
    gateway_external_id [name: 'idx']
  }
}

Table saas_bar_fiados {
  id varchar [pk]
  tenant_id varchar [not null]
  sede_id varchar [not null]
  venda_id varchar [unique, not null]
  user_id varchar [not null]
  membro_id varchar
  valor decimal(10, 2) [not null]
  vencimento timestamp [not null]
  status StatusFiadoBar [not null]
  pago_em timestamp
  metodo_pagamento_quitacao MetodoPagamentoBar
  financeiro_lancamento_id varchar [unique]
  criado_por_id varchar
  criado_em timestamp [not null]
  Indexes {
    (tenant_id, sede_id, status, vencimento) [name: 'idx']
    user_id [name: 'idx']
    membro_id [name: 'idx']
  }
  Note: 'Venda a fiado (crédito) vinculada a um membro — quitação gera o lançamento no livro-caixa só quando o débito é pago (ver docs/data/modulo-bar.md).'
}

