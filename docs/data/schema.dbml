  Indexes {
    tenant_id [name: 'idx']
    sede_id [name: 'idx']
    responsavel_user_id [name: 'idx']
  }
}

Table saas_solicitacoes_unidade {
  id varchar [pk]
  tenant_id varchar [not null]
