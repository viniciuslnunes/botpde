# Dependências
node_modules/
.pnpm-store/

# Build outputs
.next/
dist/
build/
out/

# Prisma
packages/db/node_modules/
*.db
*.db-shm
*.db-wal

# Ambiente — nunca versionar valores reais (só *.example)
.env
.env.*
!.env.example
!**/.env.example
!.env.team.example
!**/.env.team.example
.env.team
*.secrets.env
*secrets*.env
torcida-dev.secrets.env
setorize-secrets.kdbx
*.kdbx

# Dumps do banco (cópia local da Railway — ver docs/ops/postgres-local-dev.md)
.dumps/

# Notas locais com mapa de ambientes / credenciais (ex.: AMBIENTES.local.md)
*.local.md
**/*.local.md

# Scratch local (Playwright ad-hoc, capturas, dumps temporários)
shot-*.mjs
apps/web/shot-*.mjs
tmp-*.png
tmp-*.jpg
tmp-*.webp
tmp-*.json
**/tmp-*.png
**/tmp-*.jpg

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/

# Turbo
.turbo/

# Playwright (captura visual de fluxos — artefato local, ver apps/web/e2e/README.md)
apps/web/e2e/.auth/
apps/web/e2e/screenshots/
apps/web/e2e/.test-results/
apps/web/e2e/CREDENTIALS.local.md
apps/web/playwright-report/
apps/web/test-results/

# Assets locais (bot)
apps/bot/img/
apps/bot/fonts/

# Escudos de clubes — hospedados no Cloudinary (ver seed:migrate-escudos-cloudinary)
apps/web/public/escudos/*.png

# Config pessoal de editor (Cursor) — skills do time são versionadas
.cursor/*
!.cursor/skills/
!.cursor/skills/**

# Relatórios das auditorias funcionais (gerados a cada rodada, não versionados)
apps/web/auditoria-*.txt
apps/web/audit-*.txt
apps/web/seed-jornadas.txt

# Payload transitório do import de commits para o Jira (scripts/jira/import-commits.mjs
# apaga no finally; sobra só quando a execução é interrompida)
.tmp-jira-import-*.json

# Atlassian CLI (binário local — ver docs/ops/acli-jira.md)
acli
acli.exe
tools/acli
tools/acli.exe
tools/acli*
